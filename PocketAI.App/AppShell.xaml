<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="PocketAI.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:PocketAI.App.Pages"
    FlyoutBehavior="Locked"
    FlyoutWidth="250"
    Shell.NavBarIsVisible="False"
    Title="PocketAI">

    <!-- Custom Sidebar -->
    <Shell.FlyoutContent>

        <Grid
            BackgroundColor="#111827"
            Padding="18"
            RowDefinitions="Auto,*">

            <!-- Logo -->
            <VerticalStackLayout
                Grid.Row="0"
                Spacing="4"
                Margin="0,8,0,24">

                <Label
                    Text="◉ PocketAI"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="White" />

            </VerticalStackLayout>


            <!-- Navigation -->
            <Grid
                Grid.Row="1"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto"
                RowSpacing="6">

                <!-- MAIN -->
                <Label
                    Grid.Row="0"
                    Text="MAIN"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="#9CA3AF"
                    Margin="8,0,0,4" />

                <Border
                    x:Name="HomeNav"
                    Grid.Row="1"
                    BackgroundColor="#2A2340"
                    StrokeThickness="0"
                    Padding="12,10">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="HomeClicked" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="4,28,*" ColumnSpacing="10">

                        <BoxView
                            x:Name="HomeIndicator"
                            Grid.Column="0"
                            BackgroundColor="#A78BFA"
                            CornerRadius="2" />

                        <Label
                            Grid.Column="1"
                            Text="⌂"
                            FontSize="18"
                            TextColor="#E5E7EB"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="2"
                            Text="Home"
                            FontSize="15"
                            TextColor="White"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

                <Border
                    x:Name="TransactionsNav"
                    Grid.Row="2"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="12,10">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TransactionsClicked" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="4,28,*" ColumnSpacing="10">

                        <BoxView
                            x:Name="TransactionsIndicator"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            CornerRadius="2" />

                        <Label
                            Grid.Column="1"
                            Text="↕"
                            FontSize="18"
                            TextColor="#E5E7EB"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="2"
                            Text="Transactions"
                            FontSize="15"
                            TextColor="#E5E7EB"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>


                <!-- PLANNING -->
                <VerticalStackLayout
                    Grid.Row="3"
                    Spacing="6"
                    Margin="0,14,0,0">

                    <Label
                        Text="PLANNING"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#9CA3AF"
                        Margin="8,0,0,4" />

                    <Border
                        x:Name="BudgetNav"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BudgetClicked" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="4,28,*"
                            ColumnSpacing="10">

                            <BoxView
                                x:Name="BudgetIndicator"
                                Grid.Column="0"
                                BackgroundColor="Transparent"
                                CornerRadius="2" />

                            <Label
                                Grid.Column="1"
                                Text="◫"
                                FontSize="18"
                                TextColor="#E5E7EB"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                Text="Budget"
                                FontSize="15"
                                TextColor="#E5E7EB"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                    <Border
                        x:Name="SavingsNav"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SavingsClicked" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="4,28,*"
                            ColumnSpacing="10">

                            <BoxView
                                x:Name="SavingsIndicator"
                                Grid.Column="0"
                                BackgroundColor="Transparent"
                                CornerRadius="2" />

                            <Label
                                Grid.Column="1"
                                Text="◎"
                                FontSize="18"
                                TextColor="#E5E7EB"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                Text="Savings"
                                FontSize="15"
                                TextColor="#E5E7EB"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                    <Border
                        x:Name="BillsNav"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BillsClicked" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="4,28,*"
                            ColumnSpacing="10">

                            <BoxView
                                x:Name="BillsIndicator"
                                Grid.Column="0"
                                BackgroundColor="Transparent"
                                CornerRadius="2" />

                            <Label
                                Grid.Column="1"
                                Text="◷"
                                FontSize="18"
                                TextColor="#E5E7EB"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                Text="Bills"
                                FontSize="15"
                                TextColor="#E5E7EB"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>
                    
                    
                    <Border
                        x:Name="AccountsNav"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AccountsClicked" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="4,28,*"
                            ColumnSpacing="10">

                            <BoxView
                                x:Name="AccountsIndicator"
                                Grid.Column="0"
                                BackgroundColor="Transparent"
                                CornerRadius="2" />

                            <Label
                                Grid.Column="1"
                                Text="▣"
                                FontSize="18"
                                TextColor="#E5E7EB"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                Text="Accounts"
                                FontSize="15"
                                TextColor="#E5E7EB"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </VerticalStackLayout>


                <!-- INSIGHTS -->
                <VerticalStackLayout
                    Grid.Row="4"
                    Spacing="6"
                    Margin="0,14,0,0">

                    <Label
                        Text="INSIGHTS"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#9CA3AF"
                        Margin="8,0,0,4" />

                    <Border
                        x:Name="AnalyticsNav"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AnalyticsClicked" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="4,28,*"
                            ColumnSpacing="10">

                            <BoxView
                                x:Name="AnalyticsIndicator"
                                Grid.Column="0"
                                BackgroundColor="Transparent"
                                CornerRadius="2" />

                            <Label
                                Grid.Column="1"
                                Text="▥"
                                FontSize="18"
                                TextColor="#E5E7EB"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                Text="Analytics"
                                FontSize="15"
                                TextColor="#E5E7EB"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                    <Border
                        x:Name="PocketAINav"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="PocketAIClicked" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="4,28,*"
                            ColumnSpacing="10">

                            <BoxView
                                x:Name="PocketAIIndicator"
                                Grid.Column="0"
                                BackgroundColor="Transparent"
                                CornerRadius="2" />

                            <Label
                                Grid.Column="1"
                                Text="✦"
                                FontSize="18"
                                TextColor="#E5E7EB"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                Text="PocketAI"
                                FontSize="15"
                                TextColor="#E5E7EB"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </VerticalStackLayout>


                <!-- Pushes Settings/Profile to bottom -->
                <BoxView
                    Grid.Row="8"
                    BackgroundColor="Transparent" />

                <Border
                    x:Name="SettingsNav"
                    Grid.Row="9"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="12,10">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SettingsClicked" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="4,28,*"
                        ColumnSpacing="10">

                        <BoxView
                            x:Name="SettingsIndicator"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            CornerRadius="2" />

                        <Label
                            Grid.Column="1"
                            Text="⚙"
                            FontSize="18"
                            TextColor="#E5E7EB"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="2"
                            Text="Settings"
                            FontSize="15"
                            TextColor="#E5E7EB"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

                <Border
                    x:Name="ProfileNav"
                    Grid.Row="10"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="12,10">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ProfileClicked" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="4,28,*"
                        ColumnSpacing="10">

                        <BoxView
                            x:Name="ProfileIndicator"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            CornerRadius="2" />

                        <Label
                            Grid.Column="1"
                            Text="♙"
                            FontSize="18"
                            TextColor="#E5E7EB"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="2"
                            Text="Profile"
                            FontSize="15"
                            TextColor="#E5E7EB"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Shell.FlyoutContent>


    <!-- Pages -->
    <FlyoutItem
        Title="Home"
        Route="Home">

        <ShellContent
            ContentTemplate="{DataTemplate pages:HomePage}" />

    </FlyoutItem>

    <FlyoutItem
        Title="Transactions"
        Route="Transactions">

        <ShellContent
            ContentTemplate="{DataTemplate pages:TransactionsPage}" />

    </FlyoutItem>

    <FlyoutItem
        Title="Budget"
        Route="Budget">

        <ShellContent
            ContentTemplate="{DataTemplate pages:BudgetPage}" />

    </FlyoutItem>

    <FlyoutItem
        Title="Savings"
        Route="Savings">

        <ShellContent
            ContentTemplate="{DataTemplate pages:SavingsPage}" />

    </FlyoutItem>

    <FlyoutItem
        Title="Bills"
        Route="Bills">

        <ShellContent
            ContentTemplate="{DataTemplate pages:BillsPage}" />

    </FlyoutItem>

    <FlyoutItem
        Title="Accounts"
        Route="Accounts">

        <ShellContent
            ContentTemplate="{DataTemplate pages:AccountsPage}" />

    </FlyoutItem>

    <FlyoutItem
        Title="Analytics"
        Route="Analytics">

        <ShellContent
            ContentTemplate="{DataTemplate pages:AnalyticsPage}" />

    </FlyoutItem>

    <FlyoutItem
        Title="PocketAI"
        Route="PocketAI">

        <ShellContent
            ContentTemplate="{DataTemplate pages:PocketAIPage}" />

    </FlyoutItem>

    <FlyoutItem
        Title="Settings"
        Route="Settings">

        <ShellContent
            ContentTemplate="{DataTemplate pages:SettingsPage}" />

    </FlyoutItem>

    <FlyoutItem
        Title="Profile"
        Route="Profile">

        <ShellContent
            ContentTemplate="{DataTemplate pages:ProfilePage}" />

    </FlyoutItem>

</Shell>