<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="PocketAI.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:PocketAI.App.Pages"

    BackgroundColor="{DynamicResource SidebarBackground}"
    FlyoutBackgroundColor="{DynamicResource SidebarBackground}"

    FlyoutBehavior="Locked"
    FlyoutWidth="250"
    Shell.NavBarIsVisible="False"
    Title="PocketAI">

    <!-- ==========================================
         CUSTOM SIDEBAR
         ========================================== -->

    <Shell.FlyoutContent>

        <Grid
            BackgroundColor="{DynamicResource SidebarBackground}"
            Padding="18"
            RowDefinitions="Auto,*">


            <!-- ==================================
                 LOGO
                 ================================== -->

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="4"
                Margin="0,8,0,24">

                <Label
                    Text="◉ PocketAI"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource SidebarText}" />

            </VerticalStackLayout>



            <!-- ==================================
                 NAVIGATION
                 ================================== -->

            <Grid
                Grid.Row="1"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto"
                RowSpacing="6">


                <!-- ==================================
                     MAIN
                     ================================== -->

                <Label
                    Grid.Row="0"
                    Text="MAIN"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource SidebarMutedText}"
                    Margin="8,0,0,4" />



                <!-- ==================================
                     HOME
                     ================================== -->

                <Border
                    x:Name="HomeNav"
                    Grid.Row="1"
                    BackgroundColor="{DynamicResource SidebarSelectedBackground}"
                    StrokeThickness="0"
                    Padding="12,10">

                    <Border.StrokeShape>

                        <RoundRectangle
                            CornerRadius="10" />

                    </Border.StrokeShape>


                    <Border.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="HomeClicked" />

                    </Border.GestureRecognizers>


                    <Grid
                        ColumnDefinitions="4,28,*"
                        ColumnSpacing="10">


                        <BoxView
                            x:Name="HomeIndicator"
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource ThemePrimary}"
                            CornerRadius="2" />


                        <Label
                            Grid.Column="1"
                            Text="⌂"
                            FontSize="18"
                            TextColor="{DynamicResource SidebarText}"
                            VerticalOptions="Center" />


                        <Label
                            Grid.Column="2"
                            Text="Home"
                            FontSize="15"
                            TextColor="{DynamicResource SidebarText}"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>



                <!-- ==================================
                     TRANSACTIONS
                     ================================== -->

                <Border
                    x:Name="TransactionsNav"
                    Grid.Row="2"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="12,10">

                    <Border.StrokeShape>

                        <RoundRectangle
                            CornerRadius="10" />

                    </Border.StrokeShape>


                    <Border.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="TransactionsClicked" />

                    </Border.GestureRecognizers>


                    <Grid
                        ColumnDefinitions="4,28,*"
                        ColumnSpacing="10">


                        <BoxView
                            x:Name="TransactionsIndicator"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            CornerRadius="2" />


                        <Label
                            Grid.Column="1"
                            Text="↕"
                            FontSize="18"
                            TextColor="{DynamicResource SidebarText}"
                            VerticalOptions="Center" />


                        <Label
                            Grid.Column="2"
                            Text="Transactions"
                            FontSize="15"
                            TextColor="{DynamicResource SidebarText}"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>



                <!-- ==================================
                     PLANNING
                     ================================== -->

                <VerticalStackLayout
                    Grid.Row="3"
                    Spacing="6"
                    Margin="0,14,0,0">


                    <Label
                        Text="PLANNING"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource SidebarMutedText}"
                        Margin="8,0,0,4" />



                    <!-- ==================================
                         BUDGET
                         ================================== -->

                    <Border
                        x:Name="BudgetNav"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,10">

                        <Border.StrokeShape>

                            <RoundRectangle
                                CornerRadius="10" />

                        </Border.StrokeShape>


                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="BudgetClicked" />

                        </Border.GestureRecognizers>


                        <Grid
                            ColumnDefinitions="4,28,*"
                            ColumnSpacing="10">


                            <BoxView
                                x:Name="BudgetIndicator"
                                Grid.Column="0"
                                BackgroundColor="Transparent"
                                CornerRadius="2" />


                            <Label
                                Grid.Column="1"
                                Text="◫"
                                FontSize="18"
                                TextColor="{DynamicResource SidebarText}"
                                VerticalOptions="Center" />


                            <Label
                                Grid.Column="2"
                                Text="Budget"
                                FontSize="15"
                                TextColor="{DynamicResource SidebarText}"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>



                    <!-- ==================================
                         SAVINGS
                         ================================== -->

                    <Border
                        x:Name="SavingsNav"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,10">

                        <Border.StrokeShape>

                            <RoundRectangle
                                CornerRadius="10" />

                        </Border.StrokeShape>


                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="SavingsClicked" />

                        </Border.GestureRecognizers>


                        <Grid
                            ColumnDefinitions="4,28,*"
                            ColumnSpacing="10">


                            <BoxView
                                x:Name="SavingsIndicator"
                                Grid.Column="0"
                                BackgroundColor="Transparent"
                                CornerRadius="2" />


                            <Label
                                Grid.Column="1"
                                Text="◎"
                                FontSize="18"
                                TextColor="{DynamicResource SidebarText}"
                                VerticalOptions="Center" />


                            <Label
                                Grid.Column="2"
                                Text="Savings"
                                FontSize="15"
                                TextColor="{DynamicResource SidebarText}"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>



                    <!-- ==================================
                         BILLS
                         ================================== -->

                    <Border
                        x:Name="BillsNav"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,10">

                        <Border.StrokeShape>

                            <RoundRectangle
                                CornerRadius="10" />

                        </Border.StrokeShape>


                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="BillsClicked" />

                        </Border.GestureRecognizers>


                        <Grid
                            ColumnDefinitions="4,28,*"
                            ColumnSpacing="10">


                            <BoxView
                                x:Name="BillsIndicator"
                                Grid.Column="0"
                                BackgroundColor="Transparent"
                                CornerRadius="2" />


                            <Label
                                Grid.Column="1"
                                Text="◷"
                                FontSize="18"
                                TextColor="{DynamicResource SidebarText}"
                                VerticalOptions="Center" />


                            <Label
                                Grid.Column="2"
                                Text="Bills"
                                FontSize="15"
                                TextColor="{DynamicResource SidebarText}"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>



                    <!-- ==================================
                         ACCOUNTS
                         ================================== -->

                    <Border
                        x:Name="AccountsNav"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,10">

                        <Border.StrokeShape>

                            <RoundRectangle
                                CornerRadius="10" />

                        </Border.StrokeShape>


                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="AccountsClicked" />

                        </Border.GestureRecognizers>


                        <Grid
                            ColumnDefinitions="4,28,*"
                            ColumnSpacing="10">


                            <BoxView
                                x:Name="AccountsIndicator"
                                Grid.Column="0"
                                BackgroundColor="Transparent"
                                CornerRadius="2" />


                            <Label
                                Grid.Column="1"
                                Text="▣"
                                FontSize="18"
                                TextColor="{DynamicResource SidebarText}"
                                VerticalOptions="Center" />


                            <Label
                                Grid.Column="2"
                                Text="Accounts"
                                FontSize="15"
                                TextColor="{DynamicResource SidebarText}"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </VerticalStackLayout>



                <!-- ==================================
                     INSIGHTS
                     ================================== -->

                <VerticalStackLayout
                    Grid.Row="4"
                    Spacing="6"
                    Margin="0,14,0,0">


                    <Label
                        Text="INSIGHTS"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource SidebarMutedText}"
                        Margin="8,0,0,4" />



                    <!-- ==================================
                         ANALYTICS
                         ================================== -->

                    <Border
                        x:Name="AnalyticsNav"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,10">

                        <Border.StrokeShape>

                            <RoundRectangle
                                CornerRadius="10" />

                        </Border.StrokeShape>


                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="AnalyticsClicked" />

                        </Border.GestureRecognizers>


                        <Grid
                            ColumnDefinitions="4,28,*"
                            ColumnSpacing="10">


                            <BoxView
                                x:Name="AnalyticsIndicator"
                                Grid.Column="0"
                                BackgroundColor="Transparent"
                                CornerRadius="2" />


                            <Label
                                Grid.Column="1"
                                Text="▥"
                                FontSize="18"
                                TextColor="{DynamicResource SidebarText}"
                                VerticalOptions="Center" />


                            <Label
                                Grid.Column="2"
                                Text="Analytics"
                                FontSize="15"
                                TextColor="{DynamicResource SidebarText}"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>



                    <!-- ==================================
                         POCKETAI
                         ================================== -->

                    <Border
                        x:Name="PocketAINav"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,10">

                        <Border.StrokeShape>

                            <RoundRectangle
                                CornerRadius="10" />

                        </Border.StrokeShape>


                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="PocketAIClicked" />

                        </Border.GestureRecognizers>


                        <Grid
                            ColumnDefinitions="4,28,*"
                            ColumnSpacing="10">


                            <BoxView
                                x:Name="PocketAIIndicator"
                                Grid.Column="0"
                                BackgroundColor="Transparent"
                                CornerRadius="2" />


                            <Label
                                Grid.Column="1"
                                Text="✦"
                                FontSize="18"
                                TextColor="{DynamicResource SidebarText}"
                                VerticalOptions="Center" />


                            <Label
                                Grid.Column="2"
                                Text="PocketAI"
                                FontSize="15"
                                TextColor="{DynamicResource SidebarText}"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </VerticalStackLayout>



                <!-- ==================================
                     PUSH SETTINGS / PROFILE DOWN
                     ================================== -->

                <BoxView
                    Grid.Row="8"
                    BackgroundColor="Transparent" />



                <!-- ==================================
                     SETTINGS
                     ================================== -->

                <Border
                    x:Name="SettingsNav"
                    Grid.Row="9"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="12,10">

                    <Border.StrokeShape>

                        <RoundRectangle
                            CornerRadius="10" />

                    </Border.StrokeShape>


                    <Border.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="SettingsClicked" />

                    </Border.GestureRecognizers>


                    <Grid
                        ColumnDefinitions="4,28,*"
                        ColumnSpacing="10">


                        <BoxView
                            x:Name="SettingsIndicator"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            CornerRadius="2" />


                        <Label
                            Grid.Column="1"
                            Text="⚙"
                            FontSize="18"
                            TextColor="{DynamicResource SidebarText}"
                            VerticalOptions="Center" />


                        <Label
                            Grid.Column="2"
                            Text="Settings"
                            FontSize="15"
                            TextColor="{DynamicResource SidebarText}"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>



                <!-- ==================================
                     PROFILE
                     ================================== -->

                <Border
                    x:Name="ProfileNav"
                    Grid.Row="10"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="12,10">

                    <Border.StrokeShape>

                        <RoundRectangle
                            CornerRadius="10" />

                    </Border.StrokeShape>


                    <Border.GestureRecognizers>

                        <TapGestureRecognizer
                            Tapped="ProfileClicked" />

                    </Border.GestureRecognizers>


                    <Grid
                        ColumnDefinitions="4,28,*"
                        ColumnSpacing="10">


                        <BoxView
                            x:Name="ProfileIndicator"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            CornerRadius="2" />


                        <Label
                            Grid.Column="1"
                            Text="♙"
                            FontSize="18"
                            TextColor="{DynamicResource SidebarText}"
                            VerticalOptions="Center" />


                        <Label
                            Grid.Column="2"
                            Text="Profile"
                            FontSize="15"
                            TextColor="{DynamicResource SidebarText}"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Shell.FlyoutContent>



    <!-- ==========================================
         APP PAGES
         ========================================== -->


    <!-- HOME -->

    <FlyoutItem
        Title="Home"
        Route="Home">

        <ShellContent
            ContentTemplate="{DataTemplate pages:HomePage}" />

    </FlyoutItem>



    <!-- TRANSACTIONS -->

    <FlyoutItem
        Title="Transactions"
        Route="Transactions">

        <ShellContent
            ContentTemplate="{DataTemplate pages:TransactionsPage}" />

    </FlyoutItem>



    <!-- BUDGET -->

    <FlyoutItem
        Title="Budget"
        Route="Budget">

        <ShellContent
            ContentTemplate="{DataTemplate pages:BudgetPage}" />

    </FlyoutItem>



    <!-- SAVINGS -->

    <FlyoutItem
        Title="Savings"
        Route="Savings">

        <ShellContent
            ContentTemplate="{DataTemplate pages:SavingsPage}" />

    </FlyoutItem>



    <!-- BILLS -->

    <FlyoutItem
        Title="Bills"
        Route="Bills">

        <ShellContent
            ContentTemplate="{DataTemplate pages:BillsPage}" />

    </FlyoutItem>



    <!-- ACCOUNTS -->

    <FlyoutItem
        Title="Accounts"
        Route="Accounts">

        <ShellContent
            ContentTemplate="{DataTemplate pages:AccountsPage}" />

    </FlyoutItem>



    <!-- ANALYTICS -->

    <FlyoutItem
        Title="Analytics"
        Route="Analytics">

        <ShellContent
            ContentTemplate="{DataTemplate pages:AnalyticsPage}" />

    </FlyoutItem>



    <!-- POCKETAI -->

    <FlyoutItem
        Title="PocketAI"
        Route="PocketAI">

        <ShellContent
            ContentTemplate="{DataTemplate pages:PocketAIPage}" />

    </FlyoutItem>



    <!-- SETTINGS -->

    <FlyoutItem
        Title="Settings"
        Route="Settings">

        <ShellContent
            ContentTemplate="{DataTemplate pages:SettingsPage}" />

    </FlyoutItem>



    <!-- PROFILE -->

    <FlyoutItem
        Title="Profile"
        Route="Profile">

        <ShellContent
            ContentTemplate="{DataTemplate pages:ProfilePage}" />

    </FlyoutItem>

</Shell>