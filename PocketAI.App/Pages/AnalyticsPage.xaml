<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    x:Class="PocketAI.App.Pages.AnalyticsPage"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False">


    <ScrollView>

        <VerticalStackLayout
            Padding="32"
            Spacing="22">


            <!-- =====================================
                 HEADER
                 ===================================== -->

            <VerticalStackLayout
                Spacing="5">

                <Label
                    Text="ANALYTICS"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource ThemePrimary}" />

                <Label
                    Text="Understand your money."
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextPrimary}" />

                <Label
                    Text="See where your money is going, compare your spending, and understand how your finances are changing."
                    FontSize="14"
                    TextColor="{DynamicResource TextSecondary}" />

            </VerticalStackLayout>



            <!-- =====================================
                 ANALYTICS TABS
                 ===================================== -->

            <Border
                BackgroundColor="{DynamicResource CardBackground}"
                Stroke="{DynamicResource BorderColor}"
                StrokeThickness="1"
                Padding="6">

                <Border.StrokeShape>
                    <RoundRectangle
                        CornerRadius="12" />
                </Border.StrokeShape>


                <Grid
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="6">


                    <Button
                        x:Name="OverviewTabButton"
                        Grid.Column="0"
                        Text="Overview"
                        Clicked="OverviewTabClicked"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="9" />


                    <Button
                        x:Name="SpendingTabButton"
                        Grid.Column="1"
                        Text="Spending"
                        Clicked="SpendingTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource TextSecondary}"
                        FontAttributes="Bold"
                        CornerRadius="9" />


                    <Button
                        x:Name="CashFlowTabButton"
                        Grid.Column="2"
                        Text="Cash Flow"
                        Clicked="CashFlowTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource TextSecondary}"
                        FontAttributes="Bold"
                        CornerRadius="9" />


                    <Button
                        x:Name="TrendsTabButton"
                        Grid.Column="3"
                        Text="Trends"
                        Clicked="TrendsTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource TextSecondary}"
                        FontAttributes="Bold"
                        CornerRadius="9" />

                </Grid>

            </Border>



            <!-- =====================================
                 OVERVIEW TAB
                 ===================================== -->

            <VerticalStackLayout
                x:Name="OverviewSection"
                Spacing="20"
                IsVisible="True">


                <!-- =================================
                     MONEY SUMMARY
                     ================================= -->

                <Grid
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="14">


                    <!-- INCOME -->

                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">

                            <Label
                                Text="INCOME"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="OverviewIncomeLabel"
                                Text="$0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Monthly income"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- SPENT -->

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">

                            <Label
                                Text="SPENT"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="OverviewSpentLabel"
                                Text="$0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Transaction spending"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- RECURRING -->

                    <Border
                        Grid.Column="2"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">

                            <Label
                                Text="RECURRING"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="OverviewRecurringLabel"
                                Text="$0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Active monthly bills"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- MONEY LEFT -->

                    <Border
                        Grid.Column="3"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">

                            <Label
                                Text="MONEY LEFT"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="OverviewMoneyLeftLabel"
                                Text="$0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="After spending and bills"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>



                <!-- =================================
                     HEALTH + SAFE TO SPEND
                     ================================= -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="16">


                    <!-- FINANCIAL HEALTH -->

                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource CardBackground}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeThickness="1"
                        Padding="24">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="10">

                            <Label
                                Text="FINANCIAL HEALTH"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                x:Name="HealthScoreLabel"
                                Text="0 / 100"
                                FontSize="32"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />


                            <Label
                                x:Name="HealthStatusLabel"
                                Text="No data"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <ProgressBar
                                x:Name="HealthProgressBar"
                                Progress="0"
                                HeightRequest="9"
                                ProgressColor="{DynamicResource ThemePrimary}"
                                BackgroundColor="{DynamicResource BorderColor}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- SAFE TO SPEND -->

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{DynamicResource CardBackground}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeThickness="1"
                        Padding="24">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="8">

                            <Label
                                Text="SAFE TO SPEND"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                x:Name="SafeToSpendLabel"
                                Text="$0.00"
                                FontSize="32"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />


                            <Label
                                x:Name="DailySafeLabel"
                                Text="$0.00 per day"
                                FontSize="14"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                x:Name="WeeklySafeLabel"
                                Text="$0.00 per week"
                                FontSize="14"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>



                <!-- =================================
                     POCKETAI SUMMARY
                     ================================= -->

                <Border
                    BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                    Stroke="{DynamicResource ThemePrimaryLight}"
                    StrokeThickness="1"
                    Padding="22">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="14" />
                    </Border.StrokeShape>


                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="14">


                        <Label
                            Grid.Column="0"
                            Text="✦"
                            FontSize="20"
                            TextColor="{DynamicResource ThemePrimary}"
                            VerticalOptions="Start" />


                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="7">

                            <Label
                                Text="POCKETAI SUMMARY"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />


                            <Label
                                x:Name="OverviewInsightLabel"
                                Text="Add financial information to begin analyzing your money."
                                FontSize="14"
                                TextColor="{DynamicResource TextPrimary}"
                                LineHeight="1.25" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

            </VerticalStackLayout>



            <!-- =====================================
                 SPENDING TAB
                 ===================================== -->

            <VerticalStackLayout
                x:Name="SpendingSection"
                Spacing="20"
                IsVisible="False">


                <!-- =================================
                     MONTH COMPARISON
                     ================================= -->

                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="14">


                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">

                            <Label
                                Text="THIS MONTH"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="CurrentMonthSpentLabel"
                                Text="$0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                        </VerticalStackLayout>

                    </Border>



                    <Border
                        Grid.Column="1"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">

                            <Label
                                Text="LAST MONTH"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="LastMonthSpentLabel"
                                Text="$0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                        </VerticalStackLayout>

                    </Border>



                    <Border
                        Grid.Column="2"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">

                            <Label
                                Text="CHANGE"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="SpendingChangeLabel"
                                Text="N/A"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>



                <!-- =================================
                     WEEK COMPARISON CHART
                     ================================= -->

                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="16" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="18">


                        <VerticalStackLayout
                            Spacing="4">

                            <Label
                                Text="This Week vs Last Week"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Compare your daily spending from Monday through Sunday."
                                FontSize="13"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>



                        <!-- WEEK TOTALS -->

                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="15">


                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="3">

                                <Label
                                    Text="THIS WEEK"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextSecondary}" />

                                <Label
                                    x:Name="ThisWeekTotalLabel"
                                    Text="$0.00"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                            </VerticalStackLayout>



                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="3">

                                <Label
                                    Text="LAST WEEK"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextSecondary}" />

                                <Label
                                    x:Name="LastWeekTotalLabel"
                                    Text="$0.00"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                            </VerticalStackLayout>



                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="3">

                                <Label
                                    Text="CHANGE"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextSecondary}" />

                                <Label
                                    x:Name="WeeklyChangeLabel"
                                    Text="N/A"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextSecondary}" />

                            </VerticalStackLayout>

                        </Grid>



                        <!-- LIVECHART -->

                        <lvc:CartesianChart
                            x:Name="WeekComparisonChart"
                            HeightRequest="330"
                            BackgroundColor="Transparent"
                            LegendPosition="Bottom" />

                    </VerticalStackLayout>

                </Border>



                <!-- =================================
                     CATEGORY SPENDING
                     ================================= -->

                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="16" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="18">


                        <VerticalStackLayout
                            Spacing="4">

                            <Label
                                Text="Spending by Category"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="See which categories are using the largest share of your monthly spending."
                                FontSize="13"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>



                        <!-- DONUT -->

                        <Grid
                            HeightRequest="400">


                            <lvc:PieChart
                                x:Name="CategoryDonutChart"
                                BackgroundColor="Transparent"
                                LegendPosition="Bottom" />


                            <VerticalStackLayout
                                x:Name="CategoryDonutCenter"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Spacing="2"
                                InputTransparent="True"
                                IsVisible="False">

                                <Label
                                    x:Name="CategoryDonutTotalLabel"
                                    Text="$0.00"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="Total Spent"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextSecondary}"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                        </Grid>



                        <Label
                            x:Name="CategoryEmptyLabel"
                            Text="No spending this month."
                            FontSize="14"
                            TextColor="{DynamicResource TextSecondary}"
                            IsVisible="False" />



                        <!-- CATEGORY BREAKDOWN -->

                        <VerticalStackLayout
                            x:Name="CategorySpendingContainer"
                            Spacing="16">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate>

                                    <VerticalStackLayout
                                        Spacing="6">


                                        <Grid
                                            ColumnDefinitions="*,Auto">

                                            <Label
                                                Grid.Column="0"
                                                Text="{Binding Category}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource TextPrimary}" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding AmountText}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource TextPrimary}" />

                                        </Grid>


                                        <ProgressBar
                                            Progress="{Binding Progress}"
                                            HeightRequest="9"
                                            ProgressColor="{DynamicResource ThemePrimary}"
                                            BackgroundColor="{DynamicResource BorderColor}" />


                                        <Label
                                            Text="{Binding PercentText}"
                                            FontSize="11"
                                            TextColor="{DynamicResource TextSecondary}" />

                                    </VerticalStackLayout>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>



            <!-- =====================================
                 CASH FLOW TAB
                 ===================================== -->

            <VerticalStackLayout
                x:Name="CashFlowSection"
                Spacing="20"
                IsVisible="False">


                <!-- =================================
                     CASH FLOW CHART
                     ================================= -->

                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="16" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="18">


                        <VerticalStackLayout
                            Spacing="4">

                            <Label
                                Text="Income vs Outflows"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Compare your monthly income, transaction spending, recurring bills, and remaining money."
                                FontSize="13"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>


                        <lvc:CartesianChart
                            x:Name="CashFlowChart"
                            HeightRequest="350"
                            BackgroundColor="Transparent"
                            LegendPosition="Bottom" />

                    </VerticalStackLayout>

                </Border>



                <!-- =================================
                     MONTHLY CASH FLOW
                     ================================= -->

                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="16" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="20">

                        <Label
                            Text="Monthly Cash Flow"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />


                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="14">


                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Monthly Income"
                                TextColor="{DynamicResource TextSecondary}" />

                            <Label
                                x:Name="CashFlowIncomeLabel"
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="$0.00"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />



                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Transaction Spending"
                                TextColor="{DynamicResource TextSecondary}" />

                            <Label
                                x:Name="CashFlowSpendingLabel"
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="-$0.00"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource DangerColor}" />



                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="Active Recurring Bills"
                                TextColor="{DynamicResource TextSecondary}" />

                            <Label
                                x:Name="CashFlowBillsLabel"
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="-$0.00"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource DangerColor}" />



                            <BoxView
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                HeightRequest="1"
                                BackgroundColor="{DynamicResource BorderColor}"
                                VerticalOptions="Start" />


                            <Label
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="Money Remaining"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}"
                                Margin="0,12,0,0" />

                            <Label
                                x:Name="CashFlowRemainingLabel"
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="$0.00"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}"
                                Margin="0,12,0,0" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>



                <!-- =================================
                     INCOME USAGE
                     ================================= -->

                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="16" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="15">

                        <Label
                            Text="Income Usage"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />


                        <ProgressBar
                            x:Name="IncomeUsedProgressBar"
                            HeightRequest="12"
                            Progress="0"
                            ProgressColor="{DynamicResource ThemePrimary}"
                            BackgroundColor="{DynamicResource BorderColor}" />


                        <Label
                            x:Name="IncomeUsedLabel"
                            Text="0% of monthly income committed"
                            FontSize="13"
                            TextColor="{DynamicResource TextSecondary}" />

                    </VerticalStackLayout>

                </Border>



                <!-- =================================
                     PROJECTION
                     ================================= -->

                <Border
                    BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                    Stroke="{DynamicResource ThemePrimaryLight}"
                    StrokeThickness="1"
                    Padding="22">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="14" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="7">

                        <Label
                            Text="END-OF-MONTH PROJECTION"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemePrimary}" />


                        <Label
                            x:Name="ProjectedMoneyLabel"
                            Text="$0.00"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />


                        <Label
                            x:Name="ProjectionMessageLabel"
                            Text="Add spending data to create a projection."
                            FontSize="14"
                            TextColor="{DynamicResource TextSecondary}" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>



            <!-- =====================================
                 TRENDS TAB
                 ===================================== -->

            <VerticalStackLayout
                x:Name="TrendsSection"
                Spacing="20"
                IsVisible="False">


                <!-- =================================
                     SIX MONTH CHART
                     ================================= -->

                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="16" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="18">

                        <VerticalStackLayout
                            Spacing="4">

                            <Label
                                Text="6-Month Spending Trend"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Compare your monthly spending over time."
                                FontSize="13"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>


                        <lvc:CartesianChart
                            x:Name="SixMonthTrendChart"
                            HeightRequest="350"
                            BackgroundColor="Transparent"
                            LegendPosition="Bottom" />

                    </VerticalStackLayout>

                </Border>



                <!-- =================================
                     TREND SUMMARY
                     ================================= -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="16">


                    <!-- AVERAGE -->

                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="22">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">

                            <Label
                                Text="6-MONTH AVERAGE"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="SixMonthAverageLabel"
                                Text="$0.00"
                                FontSize="26"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- TREND -->

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
