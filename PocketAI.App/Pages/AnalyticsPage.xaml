<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    x:Class="PocketAI.App.Pages.AnalyticsPage"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False">


    <ScrollView>

        <VerticalStackLayout
            Padding="32"
            Spacing="22">


            <!-- =====================================
                 HEADER
                 ===================================== -->

            <VerticalStackLayout
                Spacing="5">

                <Label
                    Text="ANALYTICS"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource ThemePrimary}" />

                <Label
                    Text="Understand your money."
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextPrimary}" />

                <Label
                    Text="Separate the money you have now from monthly planning, then understand how your spending is changing."
                    FontSize="14"
                    TextColor="{DynamicResource TextSecondary}" />

            </VerticalStackLayout>



            <!-- =====================================
                 TABS
                 ===================================== -->

            <Border
                BackgroundColor="{DynamicResource CardBackground}"
                Stroke="{DynamicResource BorderColor}"
                StrokeThickness="1"
                Padding="6">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="6">

                    <Button
                        x:Name="OverviewTabButton"
                        Grid.Column="0"
                        Text="Overview"
                        Clicked="OverviewTabClicked"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="9" />

                    <Button
                        x:Name="SpendingTabButton"
                        Grid.Column="1"
                        Text="Spending"
                        Clicked="SpendingTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource TextSecondary}"
                        FontAttributes="Bold"
                        CornerRadius="9" />

                    <Button
                        x:Name="CashFlowTabButton"
                        Grid.Column="2"
                        Text="Cash Flow"
                        Clicked="CashFlowTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource TextSecondary}"
                        FontAttributes="Bold"
                        CornerRadius="9" />

                    <Button
                        x:Name="TrendsTabButton"
                        Grid.Column="3"
                        Text="Trends"
                        Clicked="TrendsTabClicked"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource TextSecondary}"
                        FontAttributes="Bold"
                        CornerRadius="9" />

                </Grid>

            </Border>



            <!-- =====================================
                 OVERVIEW
                 ===================================== -->

            <VerticalStackLayout
                x:Name="OverviewSection"
                Spacing="20"
                IsVisible="True">


                <!-- MONEY SUMMARY -->

                <Grid
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="14">


                    <!-- SPENDABLE CASH -->

                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="SPENDABLE CASH"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="OverviewSpendableCashLabel"
                                Text="$0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Checking + cash"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                            <Label
                                Text="Savings protected"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource SuccessColor}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- EXPECTED INCOME -->

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="EXPECTED INCOME"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="OverviewIncomeLabel"
                                Text="$0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Monthly planning estimate"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                            <Label
                                Text="Not current cash"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WarningColor}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- SPENT -->

                    <Border
                        Grid.Column="2"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="SPENT THIS MONTH"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="OverviewSpentLabel"
                                Text="$0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Recorded transactions"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- UPCOMING BILLS -->

                    <Border
                        Grid.Column="3"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="UPCOMING BILLS"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="OverviewUpcomingBillsLabel"
                                Text="$0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Protected from current cash"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>



                <!-- HEALTH + SAFE TO SPEND -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="16">


                    <!-- FINANCIAL HEALTH -->

                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource CardBackground}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeThickness="1"
                        Padding="24">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="10">

                            <Label
                                Text="FINANCIAL HEALTH"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />

                            <Label
                                x:Name="HealthScoreLabel"
                                Text="Not enough data"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                x:Name="HealthStatusLabel"
                                Text="Low confidence"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WarningColor}" />

                            <ProgressBar
                                x:Name="HealthProgressBar"
                                Progress="0"
                                IsVisible="False"
                                HeightRequest="9"
                                ProgressColor="{DynamicResource ThemePrimary}"
                                BackgroundColor="{DynamicResource BorderColor}" />

                            <Label
                                x:Name="HealthReasonLabel"
                                Text="PocketAI needs more financial information before it can confidently score your financial health."
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}"
                                LineBreakMode="WordWrap"
                                LineHeight="1.25" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- SAFE TO SPEND -->

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{DynamicResource CardBackground}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeThickness="1"
                        Padding="24">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="10">

                            <Label
                                x:Name="AnalyticsSafeToSpendTitleLabel"
                                Text="SAFE TO SPEND"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />

                            <Label
                                x:Name="SafeToSpendLabel"
                                Text="$0.00"
                                FontSize="32"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Total available now"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />


                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="15"
                                Margin="0,7,0,0">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="3">

                                    <Label
                                        Text="TODAY"
                                        FontSize="9"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextMuted}" />

                                    <Label
                                        x:Name="DailySafeLabel"
                                        Text="$0.00"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimary}" />

                                </VerticalStackLayout>


                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3">

                                    <Label
                                        x:Name="WeeklySafeTitleLabel"
                                        Text="THIS WEEK"
                                        FontSize="9"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextMuted}" />

                                    <Label
                                        x:Name="WeeklySafeLabel"
                                        Text="$0.00"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimary}" />

                                </VerticalStackLayout>

                            </Grid>

                            <Label
                                Text="Expected income is not included until it becomes current spendable cash."
                                FontSize="10"
                                TextColor="{DynamicResource TextMuted}"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>



                <!-- POCKETAI SUMMARY -->

                <Border
                    BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                    Stroke="{DynamicResource ThemePrimaryLight}"
                    StrokeThickness="1"
                    Padding="22">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="14">

                        <Label
                            Grid.Column="0"
                            Text="✦"
                            FontSize="20"
                            TextColor="{DynamicResource ThemePrimary}"
                            VerticalOptions="Start" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="7">

                            <Label
                                Text="POCKETAI SUMMARY"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="OverviewInsightLabel"
                                Text="PocketAI is analyzing your money."
                                FontSize="14"
                                TextColor="{DynamicResource TextPrimary}"
                                LineHeight="1.25"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

            </VerticalStackLayout>



            <!-- =====================================
                 SPENDING
                 ===================================== -->

            <VerticalStackLayout
                x:Name="SpendingSection"
                Spacing="20"
                IsVisible="False">


                <!-- MONTH COMPARISON -->

                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="14">

                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="THIS MONTH"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="CurrentMonthSpentLabel"
                                Text="$0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                        </VerticalStackLayout>

                    </Border>


                    <Border
                        Grid.Column="1"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="LAST MONTH"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="LastMonthSpentLabel"
                                Text="$0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                        </VerticalStackLayout>

                    </Border>


                    <Border
                        Grid.Column="2"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="CHANGE"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="SpendingChangeLabel"
                                Text="N/A"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>



                <!-- WEEK COMPARISON -->

                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="18">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="This Week vs Last Week"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Compare your daily spending from Monday through Sunday."
                                FontSize="13"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>


                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="15">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="3">

                                <Label
                                    Text="THIS WEEK"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextSecondary}" />

                                <Label
                                    x:Name="ThisWeekTotalLabel"
                                    Text="$0.00"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                            </VerticalStackLayout>


                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="3">

                                <Label
                                    Text="LAST WEEK"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextSecondary}" />

                                <Label
                                    x:Name="LastWeekTotalLabel"
                                    Text="$0.00"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                            </VerticalStackLayout>


                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="3">

                                <Label
                                    Text="CHANGE"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextSecondary}" />

                                <Label
                                    x:Name="WeeklyChangeLabel"
                                    Text="N/A"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextSecondary}" />

                            </VerticalStackLayout>

                        </Grid>


                        <lvc:CartesianChart
                            x:Name="WeekComparisonChart"
                            HeightRequest="330"
                            BackgroundColor="Transparent"
                            LegendPosition="Bottom" />

                    </VerticalStackLayout>

                </Border>



                <!-- CATEGORY SPENDING -->

                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="18">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Spending by Category"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="See which categories are using the largest share of your monthly spending."
                                FontSize="13"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>


                        <Grid HeightRequest="400">

                            <lvc:PieChart
                                x:Name="CategoryDonutChart"
                                BackgroundColor="Transparent"
                                LegendPosition="Bottom" />

                            <VerticalStackLayout
                                x:Name="CategoryDonutCenter"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Spacing="2"
                                InputTransparent="True"
                                IsVisible="False">

                                <Label
                                    x:Name="CategoryDonutTotalLabel"
                                    Text="$0.00"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="Total Spent"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextSecondary}"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                        </Grid>


                        <Label
                            x:Name="CategoryEmptyLabel"
                            Text="No spending this month."
                            FontSize="14"
                            TextColor="{DynamicResource TextSecondary}"
                            IsVisible="False" />


                        <VerticalStackLayout
                            x:Name="CategorySpendingContainer"
                            Spacing="16">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate>

                                    <VerticalStackLayout Spacing="6">

                                        <Grid
                                            ColumnDefinitions="*,Auto">

                                            <Label
                                                Grid.Column="0"
                                                Text="{Binding Category}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource TextPrimary}" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding AmountText}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource TextPrimary}" />

                                        </Grid>

                                        <ProgressBar
                                            Progress="{Binding Progress}"
                                            HeightRequest="9"
                                            ProgressColor="{DynamicResource ThemePrimary}"
                                            BackgroundColor="{DynamicResource BorderColor}" />

                                        <Label
                                            Text="{Binding PercentText}"
                                            FontSize="11"
                                            TextColor="{DynamicResource TextSecondary}" />

                                    </VerticalStackLayout>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>



            <!-- =====================================
                 CASH FLOW
                 ===================================== -->

            <VerticalStackLayout
                x:Name="CashFlowSection"
                Spacing="20"
                IsVisible="False">


                <!-- CURRENT CASH PROTECTION -->

                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="18">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Current Cash Protection"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="See how PocketAI protects current spendable cash before calculating Safe to Spend."
                                FontSize="13"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>

                        <lvc:CartesianChart
                            x:Name="CashFlowChart"
                            HeightRequest="350"
                            BackgroundColor="Transparent"
                            LegendPosition="Bottom" />

                    </VerticalStackLayout>

                </Border>



                <!-- CURRENT CASH BREAKDOWN -->

                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="18">

                        <Label
                            Text="Current Cash Breakdown"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />


                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="14">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Current Spendable Cash"
                                TextColor="{DynamicResource TextSecondary}" />

                            <Label
                                x:Name="CashFlowSpendableLabel"
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="$0.00"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />


                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Upcoming Bills"
                                TextColor="{DynamicResource TextSecondary}" />

                            <Label
                                x:Name="CashFlowBillsLabel"
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="-$0.00"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource DangerColor}" />


                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="Required Savings"
                                TextColor="{DynamicResource TextSecondary}" />

                            <Label
                                x:Name="CashFlowRequiredSavingsLabel"
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="-$0.00"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource DangerColor}" />


                            <Label
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="Accepted Extra Savings"
                                TextColor="{DynamicResource TextSecondary}" />

                            <Label
                                x:Name="CashFlowAcceptedSavingsLabel"
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="-$0.00"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource DangerColor}" />


                            <Label
                                Grid.Row="4"
                                Grid.Column="0"
                                Text="Safety Buffer"
                                TextColor="{DynamicResource TextSecondary}" />

                            <Label
                                x:Name="CashFlowBufferLabel"
                                Grid.Row="4"
                                Grid.Column="1"
                                Text="-$0.00"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WarningColor}" />


                            <Label
                                Grid.Row="5"
                                Grid.Column="0"
                                Text="Safe to Spend"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                x:Name="CashFlowSafeLabel"
                                Grid.Row="5"
                                Grid.Column="1"
                                Text="$0.00"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource SuccessColor}" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>



                <!-- MONTHLY PLANNING -->

                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">

                        <Label
                            Text="Monthly Planning"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />

                        <Label
                            Text="These values help plan the month. Expected income is not treated as current cash."
                            FontSize="12"
                            TextColor="{DynamicResource TextMuted}" />


                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="15">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="4">

                                <Label
                                    Text="EXPECTED INCOME"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextMuted}" />

                                <Label
                                    x:Name="PlanIncomeLabel"
                                    Text="$0.00"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                            </VerticalStackLayout>


                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4">

                                <Label
                                    Text="RECORDED SPENDING"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextMuted}" />

                                <Label
                                    x:Name="PlanSpentLabel"
                                    Text="$0.00"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                            </VerticalStackLayout>


                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="4">

                                <Label
                                    Text="PLAN REMAINING"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextMuted}" />

                                <Label
                                    x:Name="PlanRemainingLabel"
                                    Text="$0.00"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                            </VerticalStackLayout>

                        </Grid>


                        <Label
                            Text="Plan Remaining is expected income minus recorded spending and active recurring monthly bills. It is a planning number, not Safe to Spend."
                            FontSize="10"
                            TextColor="{DynamicResource TextMuted}"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>



                <!-- PROJECTION -->

                <Border
                    BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                    Stroke="{DynamicResource ThemePrimaryLight}"
                    StrokeThickness="1"
                    Padding="22">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="PROJECTED MONTH-END SPENDABLE CASH"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemePrimary}" />

                        <Label
                            x:Name="ProjectedMoneyLabel"
                            Text="$0.00"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />

                        <Label
                            x:Name="ProjectionMessageLabel"
                            Text="PocketAI is building your projection."
                            FontSize="13"
                            TextColor="{DynamicResource TextSecondary}"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>



            <!-- =====================================
                 TRENDS
                 ===================================== -->

            <VerticalStackLayout
                x:Name="TrendsSection"
                Spacing="20"
                IsVisible="False">


                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="18">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="6-Month Spending Trend"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Compare your recorded monthly spending over time."
                                FontSize="13"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>

                        <lvc:CartesianChart
                            x:Name="SixMonthTrendChart"
                            HeightRequest="350"
                            BackgroundColor="Transparent"
                            LegendPosition="Bottom" />

                    </VerticalStackLayout>

                </Border>



                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="16">

                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="22">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="6-MONTH AVERAGE"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="SixMonthAverageLabel"
                                Text="$0.00"
                                FontSize="26"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                        </VerticalStackLayout>

                    </Border>


                    <Border
                        Grid.Column="1"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="22">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="TREND"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="TrendDirectionLabel"
                                Text="Not enough data"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>

            </VerticalStackLayout>



            <BoxView
                HeightRequest="15"
                BackgroundColor="Transparent" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>