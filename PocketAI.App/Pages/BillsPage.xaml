<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketAI.App.Pages.BillsPage"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False">

    <Grid>


        <!-- =====================================
             MAIN BILLS PAGE
             ===================================== -->

        <ScrollView>

            <VerticalStackLayout
                Padding="32"
                Spacing="24">


                <!-- =================================
                     HEADER
                     ================================= -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="20">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="5">

                        <Label
                            Text="BILLS"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemePrimary}" />

                        <Label
                            Text="Know what's coming before it hits."
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />

                        <Label
                            Text="Track recurring expenses, upcoming due dates, and the money you need to protect."
                            FontSize="14"
                            TextColor="{DynamicResource TextSecondary}" />

                    </VerticalStackLayout>


                    <Button
                        Grid.Column="1"
                        Text="+ Add Bill"
                        Clicked="ShowAddBillClicked"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        Padding="18,12"
                        VerticalOptions="Center" />

                </Grid>



                <!-- =================================
                     BILL SUMMARY
                     ================================= -->

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="MONTHLY OBLIGATIONS"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Grid
                        ColumnDefinitions="*,*,*,*"
                        ColumnSpacing="14">


                        <!-- =========================
                             MONTHLY BILLS
                             ========================= -->

                        <Border
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="20">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="16" />
                            </Border.StrokeShape>


                            <VerticalStackLayout
                                Spacing="7">

                                <Label
                                    Text="MONTHLY BILLS"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource ThemePrimary}" />

                                <Label
                                    x:Name="MonthlyBillsLabel"
                                    Text="$0.00"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                                <Label
                                    Text="Active recurring costs"
                                    FontSize="11"
                                    TextColor="{DynamicResource TextMuted}" />

                            </VerticalStackLayout>

                        </Border>



                        <!-- =========================
                             ACTIVE BILLS
                             ========================= -->

                        <Border
                            Grid.Column="1"
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="20">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="16" />
                            </Border.StrokeShape>


                            <VerticalStackLayout
                                Spacing="7">

                                <Label
                                    Text="ACTIVE BILLS"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource ThemePrimary}" />

                                <Label
                                    x:Name="ActiveBillsLabel"
                                    Text="0"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                                <Label
                                    Text="Currently included"
                                    FontSize="11"
                                    TextColor="{DynamicResource TextMuted}" />

                            </VerticalStackLayout>

                        </Border>



                        <!-- =========================
                             NEXT BILL
                             ========================= -->

                        <Border
                            Grid.Column="2"
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="20">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="16" />
                            </Border.StrokeShape>


                            <VerticalStackLayout
                                Spacing="7">

                                <Label
                                    Text="NEXT BILL"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource ThemePrimary}" />

                                <Label
                                    x:Name="NextBillLabel"
                                    Text="None"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}"
                                    LineBreakMode="TailTruncation" />

                                <Label
                                    Text="Closest upcoming payment"
                                    FontSize="11"
                                    TextColor="{DynamicResource TextMuted}" />

                            </VerticalStackLayout>

                        </Border>



                        <!-- =========================
                             INACTIVE BILLS
                             ========================= -->

                        <Border
                            Grid.Column="3"
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="20">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="16" />
                            </Border.StrokeShape>


                            <VerticalStackLayout
                                Spacing="7">

                                <Label
                                    Text="INACTIVE"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource ThemePrimary}" />

                                <Label
                                    x:Name="InactiveBillsLabel"
                                    Text="0"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                                <Label
                                    Text="Paused recurring bills"
                                    FontSize="11"
                                    TextColor="{DynamicResource TextMuted}" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                </VerticalStackLayout>



                <!-- =================================
                     EMPTY STATE
                     ================================= -->

                <Border
                    x:Name="BillsEmptyState"
                    IsVisible="False"
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="45">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="16" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="12">


                        <Border
                            WidthRequest="54"
                            HeightRequest="54"
                            BackgroundColor="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="17" />
                            </Border.StrokeShape>


                            <Label
                                Text="◷"
                                FontSize="23"
                                TextColor="{DynamicResource ThemePrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>


                        <Label
                            Text="No recurring bills yet"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}"
                            HorizontalTextAlignment="Center" />


                        <Label
                            Text="Add recurring expenses so PocketAI can plan around your monthly obligations."
                            FontSize="14"
                            TextColor="{DynamicResource TextSecondary}"
                            HorizontalTextAlignment="Center"
                            WidthRequest="500" />


                        <Button
                            Text="+ Add Your First Bill"
                            Clicked="ShowAddBillClicked"
                            BackgroundColor="{DynamicResource ThemePrimary}"
                            TextColor="{DynamicResource TextOnPrimary}"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            Margin="0,8,0,0"
                            HorizontalOptions="Center" />

                    </VerticalStackLayout>

                </Border>



                <!-- =================================
                     BILL LIST
                     ================================= -->

                <VerticalStackLayout
                    Spacing="12">


                    <VerticalStackLayout
                        Spacing="3">

                        <Label
                            Text="Recurring Bills"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />

                        <Label
                            Text="Active bills are included when PocketAI determines how much money is available."
                            FontSize="12"
                            TextColor="{DynamicResource TextSecondary}" />

                    </VerticalStackLayout>



                    <VerticalStackLayout
                        x:Name="BillsContainer"
                        Spacing="14">


                        <BindableLayout.ItemTemplate>

                            <DataTemplate>


                                <!-- =========================
                                     BILL CARD
                                     ========================= -->

                                <Border
                                    BackgroundColor="{DynamicResource CardBackground}"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeThickness="1"
                                    Padding="22">

                                    <Border.StrokeShape>
                                        <RoundRectangle
                                            CornerRadius="16" />
                                    </Border.StrokeShape>


                                    <VerticalStackLayout
                                        Spacing="16">


                                        <!-- =================
                                             TOP ROW
                                             ================= -->

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="20">


                                            <VerticalStackLayout
                                                Grid.Column="0"
                                                Spacing="5">


                                                <HorizontalStackLayout
                                                    Spacing="10">


                                                    <!-- BILL NAME -->

                                                    <Label
                                                        Text="{Binding Name}"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextPrimary}"
                                                        VerticalOptions="Center" />



                                                    <!-- ACTIVE STATUS -->

                                                    <Border
                                                        BackgroundColor="{Binding StatusBackgroundColor}"
                                                        StrokeThickness="0"
                                                        Padding="9,3"
                                                        VerticalOptions="Center">

                                                        <Border.StrokeShape>
                                                            <RoundRectangle
                                                                CornerRadius="8" />
                                                        </Border.StrokeShape>


                                                        <Label
                                                            Text="{Binding ActiveStatusText}"
                                                            FontSize="10"
                                                            FontAttributes="Bold"
                                                            TextColor="{Binding StatusColor}" />

                                                    </Border>

                                                </HorizontalStackLayout>



                                                <!-- CATEGORY -->

                                                <Label
                                                    Text="{Binding Category}"
                                                    FontSize="13"
                                                    TextColor="{DynamicResource TextSecondary}" />

                                            </VerticalStackLayout>



                                            <!-- AMOUNT -->

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding AmountText}"
                                                FontSize="20"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource TextPrimary}"
                                                VerticalOptions="Center" />

                                        </Grid>



                                        <!-- DIVIDER -->

                                        <BoxView
                                            HeightRequest="1"
                                            BackgroundColor="{DynamicResource BorderColor}" />



                                        <!-- =================
                                             BILL DETAILS
                                             ================= -->

                                        <Grid
                                            ColumnDefinitions="*,*,*"
                                            ColumnSpacing="20">


                                            <!-- DUE DATE -->

                                            <VerticalStackLayout
                                                Grid.Column="0"
                                                Spacing="3">

                                                <Label
                                                    Text="DUE DATE"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextMuted}" />

                                                <Label
                                                    Text="{Binding DueDateText}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextPrimary}" />

                                            </VerticalStackLayout>



                                            <!-- NEXT PAYMENT -->

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="3">

                                                <Label
                                                    Text="NEXT PAYMENT"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextMuted}" />

                                                <Label
                                                    Text="{Binding NextPaymentText}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextPrimary}" />

                                            </VerticalStackLayout>



                                            <!-- STATUS -->

                                            <VerticalStackLayout
                                                Grid.Column="2"
                                                Spacing="3">

                                                <Label
                                                    Text="STATUS"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextMuted}" />

                                                <Label
                                                    Text="{Binding DueStatusText}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{Binding DueStatusColor}" />

                                            </VerticalStackLayout>

                                        </Grid>



                                        <!-- =================
                                             ACTIONS
                                             ================= -->

                                        <HorizontalStackLayout
                                            HorizontalOptions="End"
                                            Spacing="10">


                                            <Button
                                                Text="{Binding ToggleText}"
                                                Clicked="ToggleBillActiveClicked"
                                                BackgroundColor="{DynamicResource SurfaceBackground}"
                                                TextColor="{DynamicResource ThemePrimary}"
                                                BorderColor="{DynamicResource ThemePrimary}"
                                                BorderWidth="1"
                                                FontAttributes="Bold"
                                                CornerRadius="9"
                                                Padding="14,8" />

                                            <Button
                                                Text="{Binding PaymentButtonText}"
                                                Clicked="ToggleBillPaidClicked"
                                                IsVisible="{Binding ShowPaymentAction}"
                                                BackgroundColor="{DynamicResource ThemePrimary}"
                                                TextColor="{DynamicResource TextOnPrimary}"
                                                FontAttributes="Bold"
                                                CornerRadius="9"
                                                Padding="14,8" />
                                                
                                            <Button
                                                Text="Edit"
                                                Clicked="ShowEditBillClicked"
                                                BackgroundColor="{DynamicResource SurfaceBackground}"
                                                TextColor="{DynamicResource TextPrimary}"
                                                BorderColor="{DynamicResource BorderColor}"
                                                BorderWidth="1"
                                                FontAttributes="Bold"
                                                CornerRadius="9"
                                                Padding="14,8" />

                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>



                <!-- BOTTOM SPACING -->

                <BoxView
                    HeightRequest="15"
                    BackgroundColor="Transparent" />

            </VerticalStackLayout>

        </ScrollView>



        <!-- =====================================
             MODAL BACKGROUND
             ===================================== -->

        <BoxView
            x:Name="ModalBackground"
            ZIndex="10"
            IsVisible="False"
            BackgroundColor="#90000000">

            <BoxView.GestureRecognizers>

                <TapGestureRecognizer
                    Tapped="CloseBillModalBackgroundClicked" />

            </BoxView.GestureRecognizers>

        </BoxView>



        <!-- =====================================
             ADD / EDIT BILL MODAL
             ===================================== -->

        <Border
            x:Name="BillModal"
            ZIndex="20"
            IsVisible="False"
            WidthRequest="460"
            Padding="28"
            BackgroundColor="{DynamicResource CardBackground}"
            Stroke="{DynamicResource BorderColor}"
            StrokeThickness="1"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Border.StrokeShape>
                <RoundRectangle
                    CornerRadius="18" />
            </Border.StrokeShape>


            <VerticalStackLayout
                Spacing="17">


                <!-- =================================
                     MODAL HEADER
                     ================================= -->

                <VerticalStackLayout
                    Spacing="4">

                    <Label
                        x:Name="BillModalTitleLabel"
                        Text="ADD BILL"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimary}" />

                    <Label
                        Text="Add a recurring payment so PocketAI can reserve money for it."
                        FontSize="12"
                        TextColor="{DynamicResource TextSecondary}" />

                </VerticalStackLayout>



                <!-- =================================
                     BILL NAME
                     ================================= -->

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="Bill Name"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />

                    <Entry
                        x:Name="BillNameEntry"
                        Placeholder="Netflix"
                        PlaceholderColor="{DynamicResource TextMuted}"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- =================================
                     CATEGORY
                     ================================= -->

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="Category"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />

                    <Picker
                        x:Name="BillCategoryPicker"
                        Title="Select a category"
                        TitleColor="{DynamicResource TextMuted}"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- =================================
                     AMOUNT
                     ================================= -->

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="Monthly Amount"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />

                    <Entry
                        x:Name="BillAmountEntry"
                        Placeholder="25.00"
                        PlaceholderColor="{DynamicResource TextMuted}"
                        Keyboard="Numeric"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- =================================
                     DUE DAY
                     ================================= -->

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="Due Day"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />

                    <Entry
                        x:Name="BillDueDayEntry"
                        Placeholder="15"
                        PlaceholderColor="{DynamicResource TextMuted}"
                        Keyboard="Numeric"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                    <Label
                        Text="Enter a day from 1 to 31."
                        FontSize="11"
                        TextColor="{DynamicResource TextMuted}" />

                </VerticalStackLayout>



                <!-- =================================
                     ACTIVE BILL
                     ================================= -->

                <Border
                    BackgroundColor="{DynamicResource SurfaceBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="12">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="10" />
                    </Border.StrokeShape>


                    <Grid
                        ColumnDefinitions="*,Auto">


                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="3">

                            <Label
                                Text="Active Bill"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Inactive bills won't reduce available money."
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>


                        <Switch
                            x:Name="BillActiveSwitch"
                            Grid.Column="1"
                            IsToggled="True"
                            VerticalOptions="Center"
                            OnColor="{DynamicResource ThemePrimary}" />

                    </Grid>

                </Border>



                <!-- =================================
                     SAVE / CANCEL
                     ================================= -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Margin="0,8,0,0">

                    <Button
                        Grid.Column="0"
                        Text="Cancel"
                        Clicked="CancelBillModalClicked"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}"
                        BorderColor="{DynamicResource BorderColor}"
                        BorderWidth="1"
                        CornerRadius="10" />


                    <Button
                        x:Name="SaveBillButton"
                        Grid.Column="1"
                        Text="Add Bill"
                        Clicked="SaveBillClicked"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="10" />

                </Grid>



                <!-- =================================
                     DELETE
                     ================================= -->

                <Button
                    x:Name="DeleteBillButton"
                    Text="Delete Bill"
                    Clicked="DeleteBillClicked"
                    BackgroundColor="{DynamicResource DangerBackground}"
                    TextColor="{DynamicResource DangerColor}"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    IsVisible="False" />

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>