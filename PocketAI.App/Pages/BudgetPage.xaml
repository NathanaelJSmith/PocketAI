<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketAI.App.Pages.BudgetPage"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False">

    <Grid>


        <!-- =====================================
             MAIN BUDGET PAGE
             ===================================== -->

        <ScrollView>

            <VerticalStackLayout
                Padding="32"
                Spacing="24">


                <!-- =================================
                     HEADER
                     ================================= -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="20">


                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="5">

                        <Label
                            Text="BUDGET"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemePrimary}" />

                        <Label
                            Text="Plan your monthly spending."
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />

                        <Label
                            Text="Set simple category limits and see which areas need your attention."
                            FontSize="14"
                            TextColor="{DynamicResource TextSecondary}" />

                    </VerticalStackLayout>


                    <Button
                        Grid.Column="1"
                        Text="+ Add Budget"
                        Clicked="ShowAddBudgetClicked"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        Padding="18,12"
                        VerticalOptions="Center" />

                </Grid>



                <!-- =================================
                SUMMARY
                ================================= -->

            <VerticalStackLayout
                Spacing="10">

                <Label
                    Text="THIS MONTH"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextSecondary}" />


                <Grid
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="14">


                    <!-- =================================
                        TOTAL BUDGET
                        ================================= -->

                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">

                            <Label
                                Text="TOTAL BUDGET"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="TotalBudgetLabel"
                                Text="$0.00"
                                FontSize="26"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Your spending plan"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- =================================
                        SPENT
                        ================================= -->

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">

                            <Label
                                Text="SPENT"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="BudgetSpentLabel"
                                Text="$0.00"
                                FontSize="26"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Against your budgets"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- =================================
                        REMAINING
                        ================================= -->

                    <Border
                        Grid.Column="2"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">

                            <Label
                                Text="REMAINING"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="BudgetRemainingLabel"
                                Text="$0.00"
                                FontSize="26"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Available in your plan"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- =================================
                        OVER BUDGET
                        ================================= -->

                    <Border
                        Grid.Column="3"
                        BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                        Stroke="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="1"
                        Padding="20">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">

                            <Label
                                Text="OVER BUDGET"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                            <Label
                                x:Name="OverBudgetCountLabel"
                                Text="0"
                                FontSize="26"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Categories over limit"
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>

            </VerticalStackLayout>



                <!-- =================================
                     CATEGORY HEADER
                     ================================= -->

                <Grid
                    ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="3">

                        <Label
                            Text="Monthly Categories"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />

                        <Label
                            Text="Select a category to edit its monthly limit."
                            FontSize="12"
                            TextColor="{DynamicResource TextSecondary}" />

                    </VerticalStackLayout>

                </Grid>



                <!-- =================================
                     EMPTY STATE
                     ================================= -->

                <Border
                    x:Name="BudgetEmptyState"
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="40"
                    IsVisible="False">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        Spacing="10"
                        HorizontalOptions="Center">

                        <Border
                            WidthRequest="52"
                            HeightRequest="52"
                            BackgroundColor="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="16" />
                            </Border.StrokeShape>

                            <Label
                                Text="◫"
                                FontSize="22"
                                TextColor="{DynamicResource ThemePrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                        <Label
                            Text="No budgets yet"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Create your first monthly category limit to start tracking your plan."
                            FontSize="13"
                            TextColor="{DynamicResource TextSecondary}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Budgets help BudgetAI understand what matters most to you."
                            FontSize="12"
                            TextColor="{DynamicResource TextMuted}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>



                <!-- =================================
                     REAL BUDGETS
                     ================================= -->

                <CollectionView
                    x:Name="BudgetCollectionView"
                    SelectionMode="Single"
                    SelectionChanged="BudgetSelected">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                BackgroundColor="{DynamicResource CardBackground}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                Padding="22"
                                Margin="0,0,0,12">

                                <Border.StrokeShape>
                                    <RoundRectangle
                                        CornerRadius="16" />
                                </Border.StrokeShape>


                                <VerticalStackLayout
                                    Spacing="14">


                                    <!-- CATEGORY + STATUS -->

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="20">


                                        <VerticalStackLayout
                                            Grid.Column="0"
                                            Spacing="4">

                                            <Label
                                                Text="{Binding Category}"
                                                FontSize="17"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource TextPrimary}" />

                                            <Label
                                                Text="{Binding SpentOfLimitText}"
                                                FontSize="13"
                                                TextColor="{DynamicResource TextSecondary}" />

                                        </VerticalStackLayout>



                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            Spacing="4">

                                            <Label
                                                Text="{Binding RemainingText}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="{Binding RemainingColor}"
                                                HorizontalTextAlignment="End" />

                                            <Label
                                                Text="{Binding StatusText}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{Binding StatusColor}"
                                                HorizontalTextAlignment="End" />

                                        </VerticalStackLayout>

                                    </Grid>



                                    <!-- PROGRESS -->

                                    <ProgressBar
                                        Progress="{Binding Progress}"
                                        ProgressColor="{Binding ProgressColor}"
                                        BackgroundColor="{DynamicResource BorderColor}"
                                        HeightRequest="8" />



                                    <!-- SPENT / PERCENT -->

                                    <Grid
                                        ColumnDefinitions="*,Auto">

                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding SpentText}"
                                            FontSize="12"
                                            TextColor="{DynamicResource TextSecondary}" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding PercentText}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="{DynamicResource TextSecondary}" />

                                    </Grid>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>


                <BoxView
                    HeightRequest="15"
                    BackgroundColor="Transparent" />

            </VerticalStackLayout>

        </ScrollView>



        <!-- =====================================
             MODAL BACKGROUND
             ===================================== -->

        <BoxView
            x:Name="ModalBackground"
            ZIndex="10"
            BackgroundColor="#90000000"
            IsVisible="False">

            <BoxView.GestureRecognizers>

                <TapGestureRecognizer
                    Tapped="CloseBudgetModalClicked" />

            </BoxView.GestureRecognizers>

        </BoxView>



        <!-- =====================================
             ADD / EDIT BUDGET MODAL
             ===================================== -->

        <Border
            x:Name="BudgetModal"
            ZIndex="20"
            IsVisible="False"
            BackgroundColor="{DynamicResource CardBackground}"
            Stroke="{DynamicResource BorderColor}"
            StrokeThickness="1"
            Padding="28"
            WidthRequest="440"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Border.StrokeShape>
                <RoundRectangle
                    CornerRadius="18" />
            </Border.StrokeShape>


            <VerticalStackLayout
                Spacing="18">


                <!-- HEADER -->

                <VerticalStackLayout
                    Spacing="4">

                    <Label
                        x:Name="BudgetModalTitleLabel"
                        Text="ADD BUDGET"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimary}" />

                    <Label
                        Text="Choose a category and decide how much you want available this month."
                        FontSize="12"
                        TextColor="{DynamicResource TextSecondary}" />

                </VerticalStackLayout>



                <!-- CATEGORY -->

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="Category"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />

                    <Picker
                        x:Name="BudgetCategoryPicker"
                        Title="Choose a category"
                        TitleColor="{DynamicResource TextMuted}"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- LIMIT -->

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="Monthly Limit"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />

                    <Entry
                        x:Name="BudgetLimitEntry"
                        Placeholder="500.00"
                        PlaceholderColor="{DynamicResource TextMuted}"
                        Keyboard="Numeric"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- BUTTONS -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Margin="0,8,0,0">

                    <Button
                        Grid.Column="0"
                        Text="Cancel"
                        Clicked="CancelBudgetClicked"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}"
                        BorderColor="{DynamicResource BorderColor}"
                        BorderWidth="1"
                        CornerRadius="10" />

                    <Button
                        Grid.Column="1"
                        x:Name="SaveBudgetButton"
                        Text="Add Budget"
                        Clicked="SaveBudgetClicked"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="10" />

                </Grid>



                <!-- DELETE -->

                <Button
                    x:Name="DeleteBudgetButton"
                    Text="Delete Budget"
                    Clicked="DeleteBudgetClicked"
                    BackgroundColor="{DynamicResource DangerBackground}"
                    TextColor="{DynamicResource DangerColor}"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    IsVisible="False" />

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>