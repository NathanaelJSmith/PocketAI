<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketAI.App.Pages.HomePage"
    BackgroundColor="{DynamicResource PageBackground}">


    <ScrollView>

        <VerticalStackLayout
            Padding="32"
            Spacing="24">


            <!-- =====================================
                 PAGE HEADER
                 ===================================== -->

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="20">


                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="4">

                    <Label
                        Text="HOME"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource ThemePrimary}" />


                    <Label
                        x:Name="GreetingLabel"
                        Text="Good afternoon"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimary}"
                        Margin="0,4,0,0" />


                    <Label
                        Text="Here's what matters with your money today."
                        FontSize="15"
                        TextColor="{DynamicResource TextSecondary}" />

                </VerticalStackLayout>



                <Button
                    Grid.Column="1"
                    Text="+ Add Expense"
                    BackgroundColor="{DynamicResource ThemePrimary}"
                    TextColor="{DynamicResource TextOnPrimary}"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    Padding="20,12"
                    VerticalOptions="Center"
                    Clicked="AddExpenseClicked" />

            </Grid>



            <!-- =====================================
                 MAIN FINANCIAL OVERVIEW
                 ===================================== -->

            <Grid
                ColumnDefinitions="1.65*,1*"
                ColumnSpacing="18">


                <!-- =================================
                     SAFE TO SPEND HERO
                     ================================= -->

                <Border
                    Grid.Column="0"
                    BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                    Stroke="{DynamicResource ThemePrimaryLight}"
                    StrokeThickness="1"
                    Padding="28">

                    <Border.StrokeShape>

                        <RoundRectangle
                            CornerRadius="20" />

                    </Border.StrokeShape>


                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="20">


                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="10">


                            <Label
                                x:Name="SafeToSpendTitleLabel"
                                Text="SAFE TO SPEND"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />


                            <!-- TOTAL -->

                            <Label
                                x:Name="SafeToSpendTotalLabel"
                                Text="$0.00"
                                FontSize="48"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}"
                                Margin="0,4,0,0" />


                            <Label
                                Text="available in your monthly plan"
                                FontSize="12"
                                TextColor="{DynamicResource TextSecondary}" />



                            <!-- TODAY / WEEK -->

                            <Grid
                                ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="32"
                                Margin="0,10,0,0">


                                <!-- TODAY -->

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="3">

                                    <Label
                                        Text="TODAY"
                                        FontSize="9"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextMuted}" />

                                    <Label
                                        x:Name="DailySafeToSpendLabel"
                                        Text="$0.00"
                                        FontSize="19"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimary}" />

                                </VerticalStackLayout>



                                <!-- THIS WEEK -->

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3">

                                    <Label
                                        x:Name="WeeklySafeToSpendTitleLabel"
                                        Text="THIS WEEK"
                                        FontSize="9"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextMuted}" />

                                    <Label
                                        x:Name="WeeklySafeToSpendLabel"
                                        Text="$0.00"
                                        FontSize="19"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimary}" />

                                </VerticalStackLayout>

                            </Grid>



                            <!-- STATUS -->

                            <Label
                                x:Name="SafeToSpendStatusLabel"
                                Text="Calculating..."
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource SuccessColor}"
                                Margin="0,8,0,0" />



                            <!-- EXPLANATION -->

                            <Label
                                Text="Based on your expected monthly income after spending, upcoming bills, required savings, and accepted extra savings."
                                FontSize="11"
                                TextColor="{DynamicResource TextMuted}"
                                LineHeight="1.25"
                                LineBreakMode="WordWrap"
                                Margin="0,5,0,0" />

                        </VerticalStackLayout>



                        <!-- ACCENT -->

                        <Border
                            Grid.Column="1"
                            WidthRequest="58"
                            HeightRequest="58"
                            BackgroundColor="{DynamicResource ThemePrimary}"
                            StrokeThickness="0"
                            VerticalOptions="Start">

                            <Border.StrokeShape>

                                <RoundRectangle
                                    CornerRadius="17" />

                            </Border.StrokeShape>


                            <Label
                                Text="$"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextOnPrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                    </Grid>

                </Border>



                <!-- =================================
                     FINANCIAL HEALTH
                     ================================= -->

                <Border
                    Grid.Column="1"
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>

                        <RoundRectangle
                            CornerRadius="20" />

                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="9">


                        <Label
                            Text="FINANCIAL HEALTH"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextSecondary}" />


                        <Label
                            x:Name="FinancialHealthScoreLabel"
                            Text="Not enough data"
                            FontSize="25"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}"
                            Margin="0,8,0,0" />


                        <Label
                            x:Name="FinancialHealthStatusLabel"
                            Text="Low confidence"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource WarningColor}" />


                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{DynamicResource BorderColor}"
                            Margin="0,8,0,4" />


                        <Label
                            x:Name="FinancialHealthReasonLabel"
                            Text="PocketAI needs more financial activity before it can confidently score your financial health."
                            FontSize="11"
                            TextColor="{DynamicResource TextMuted}"
                            LineHeight="1.25"
                            LineBreakMode="WordWrap" />


                        <Label
                            Text="View Breakdown →"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemePrimary}"
                            Margin="0,7,0,0">

                            <Label.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="ViewAnalyticsClicked" />

                            </Label.GestureRecognizers>

                        </Label>

                    </VerticalStackLayout>

                </Border>

            </Grid>



            <!-- =====================================
                 POCKETAI INSIGHT
                 ===================================== -->

            <Border
                BackgroundColor="{DynamicResource CardBackground}"
                Stroke="{DynamicResource BorderColor}"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>

                    <RoundRectangle
                        CornerRadius="18" />

                </Border.StrokeShape>


                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="16">


                    <Border
                        Grid.Column="0"
                        WidthRequest="46"
                        HeightRequest="46"
                        BackgroundColor="{DynamicResource ThemePrimaryLight}"
                        StrokeThickness="0"
                        VerticalOptions="Start">

                        <Border.StrokeShape>

                            <RoundRectangle
                                CornerRadius="13" />

                        </Border.StrokeShape>


                        <Label
                            Text="✦"
                            FontSize="20"
                            TextColor="{DynamicResource ThemePrimary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>



                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="7">


                        <Label
                            Text="POCKETAI INSIGHT"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemePrimary}" />


                        <Label
                            x:Name="PocketAIInsightLabel"
                            Text="PocketAI is analyzing your finances."
                            FontSize="16"
                            TextColor="{DynamicResource TextPrimary}"
                            LineHeight="1.3"
                            LineBreakMode="WordWrap" />


                        <Label
                            Text="Ask PocketAI about this →"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemePrimary}"
                            Margin="0,4,0,0">

                            <Label.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="AskPocketAIClicked" />

                            </Label.GestureRecognizers>

                        </Label>

                    </VerticalStackLayout>

                </Grid>

            </Border>



            <!-- =====================================
                 YOUR MONEY
                 ===================================== -->

            <VerticalStackLayout
                Spacing="12">


                <Grid
                    ColumnDefinitions="*,Auto">


                    <Label
                        Grid.Column="0"
                        Text="YOUR MONEY"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimary}" />


                    <Label
                        Grid.Column="1"
                        Text="Current money vs. monthly planning"
                        FontSize="12"
                        TextColor="{DynamicResource TextMuted}" />

                </Grid>



                <Grid
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="14">


                    <!-- =================================
                         TOTAL BALANCE
                         ================================= -->

                    <Border
                        Grid.Column="0"
                        BackgroundColor="{DynamicResource CardBackground}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeThickness="1"
                        Padding="18">

                        <Border.StrokeShape>

                            <RoundRectangle
                                CornerRadius="15" />

                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">


                            <Label
                                Text="TOTAL BALANCE"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                x:Name="TotalBalanceLabel"
                                Text="$0.00"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />


                            <Label
                                Text="All accounts • includes savings"
                                FontSize="10"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- =================================
                         SPENDABLE CASH
                         ================================= -->

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{DynamicResource CardBackground}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeThickness="1"
                        Padding="18">

                        <Border.StrokeShape>

                            <RoundRectangle
                                CornerRadius="15" />

                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">


                            <Label
                                Text="SPENDABLE CASH"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                x:Name="SpendableCashLabel"
                                Text="$0.00"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />


                            <Label
                                Text="Checking + cash"
                                FontSize="10"
                                TextColor="{DynamicResource TextMuted}" />


                            <Label
                                Text="Savings protected"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource SuccessColor}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- =================================
                         EXPECTED INCOME
                         ================================= -->

                    <Border
                        Grid.Column="2"
                        BackgroundColor="{DynamicResource CardBackground}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeThickness="1"
                        Padding="18">

                        <Border.StrokeShape>

                            <RoundRectangle
                                CornerRadius="15" />

                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">


                            <Label
                                Text="EXPECTED INCOME"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                x:Name="MonthlyIncomeLabel"
                                Text="$0.00"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />


                            <Label
                                Text="Monthly planning estimate"
                                FontSize="10"
                                TextColor="{DynamicResource TextMuted}" />


                            <Label
                                Text="Not current cash"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource WarningColor}" />

                        </VerticalStackLayout>

                    </Border>



                    <!-- =================================
                         SPENT
                         ================================= -->

                    <Border
                        Grid.Column="3"
                        BackgroundColor="{DynamicResource CardBackground}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeThickness="1"
                        Padding="18">

                        <Border.StrokeShape>

                            <RoundRectangle
                                CornerRadius="15" />

                        </Border.StrokeShape>


                        <VerticalStackLayout
                            Spacing="7">


                            <Label
                                Text="SPENT THIS MONTH"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                x:Name="MonthlySpentLabel"
                                Text="$0.00"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />


                            <Label
                                Text="Recorded transactions"
                                FontSize="10"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>

            </VerticalStackLayout>



            <!-- =====================================
                 SAVINGS + BUDGET
                 ===================================== -->

            <Grid
                ColumnDefinitions="1*,1.4*"
                ColumnSpacing="18">


                <!-- =================================
                     SAVINGS GOAL
                     ================================= -->

                <Border
                    Grid.Column="0"
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="22">

                    <Border.StrokeShape>

                        <RoundRectangle
                            CornerRadius="18" />

                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="10">


                        <Grid
                            ColumnDefinitions="*,Auto">


                            <Label
                                Grid.Column="0"
                                Text="SAVINGS"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                Grid.Column="1"
                                Text="View →"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}">

                                <Label.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Tapped="ViewSavingsClicked" />

                                </Label.GestureRecognizers>

                            </Label>

                        </Grid>



                        <Label
                            x:Name="SavingsGoalNameLabel"
                            Text="No active goal"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}"
                            Margin="0,5,0,0" />


                        <Label
                            x:Name="SavingsProgressAmountLabel"
                            Text="$0.00 / $0.00"
                            FontSize="14"
                            TextColor="{DynamicResource TextSecondary}" />


                        <ProgressBar
                            x:Name="SavingsProgressBar"
                            Progress="0"
                            ProgressColor="{DynamicResource ThemePrimary}"
                            BackgroundColor="{DynamicResource BorderColor}"
                            HeightRequest="9"
                            Margin="0,5,0,0" />


                        <Grid
                            ColumnDefinitions="Auto,*">


                            <Label
                                x:Name="SavingsProgressPercentLabel"
                                Grid.Column="0"
                                Text="0%"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />


                            <Label
                                x:Name="SavingsRemainingLabel"
                                Grid.Column="1"
                                Text="$0.00 remaining"
                                FontSize="12"
                                TextColor="{DynamicResource TextSecondary}"
                                HorizontalOptions="End" />

                        </Grid>



                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{DynamicResource BorderColor}"
                            Margin="0,4,0,2" />


                        <Label
                            x:Name="WeeklySavingsNeededLabel"
                            Text="$0.00/week needed"
                            FontSize="12"
                            TextColor="{DynamicResource TextSecondary}" />


                        <Label
                            x:Name="SavingsStatusLabel"
                            Text="No savings goal"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextSecondary}" />

                    </VerticalStackLayout>

                </Border>



                <!-- =================================
                     BUDGET SNAPSHOT
                     ================================= -->

                <Border
                    Grid.Column="1"
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="22">

                    <Border.StrokeShape>

                        <RoundRectangle
                            CornerRadius="18" />

                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="16">


                        <Grid
                            ColumnDefinitions="*,Auto">


                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="2">

                                <Label
                                    Text="BUDGET"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextSecondary}" />


                                <Label
                                    Text="Keep an eye on your spending limits."
                                    FontSize="12"
                                    TextColor="{DynamicResource TextMuted}" />

                            </VerticalStackLayout>


                            <Label
                                Grid.Column="1"
                                Text="View Budget →"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}"
                                VerticalOptions="Center">

                                <Label.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Tapped="ViewBudgetClicked" />

                                </Label.GestureRecognizers>

                            </Label>

                        </Grid>



                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{DynamicResource BorderColor}" />



                        <Label
                            x:Name="BudgetEmptyLabel"
                            Text="No budget information yet."
                            FontSize="13"
                            TextColor="{DynamicResource TextSecondary}" />



                        <VerticalStackLayout
                            x:Name="BudgetSnapshotContainer"
                            Spacing="14" />

                    </VerticalStackLayout>

                </Border>

            </Grid>



            <!-- =====================================
                 UPCOMING BILLS
                 ===================================== -->

            <Border
                BackgroundColor="{DynamicResource CardBackground}"
                Stroke="{DynamicResource BorderColor}"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>

                    <RoundRectangle
                        CornerRadius="18" />

                </Border.StrokeShape>


                <VerticalStackLayout
                    Spacing="16">


                    <Grid
                        ColumnDefinitions="*,Auto">


                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="2">

                            <Label
                                Text="UPCOMING BILLS"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                Text="Know what's coming before you spend."
                                FontSize="12"
                                TextColor="{DynamicResource TextMuted}" />

                        </VerticalStackLayout>


                        <Label
                            Grid.Column="1"
                            Text="View All →"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemePrimary}"
                            VerticalOptions="Center">

                            <Label.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="ViewBillsClicked" />

                            </Label.GestureRecognizers>

                        </Label>

                    </Grid>



                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{DynamicResource BorderColor}" />



                    <Label
                        x:Name="BillsEmptyLabel"
                        Text="No upcoming bills."
                        FontSize="13"
                        TextColor="{DynamicResource TextSecondary}" />



                    <VerticalStackLayout
                        x:Name="UpcomingBillsContainer"
                        Spacing="14" />

                </VerticalStackLayout>

            </Border>



            <!-- =====================================
                 BOTTOM SPACING
                 ===================================== -->

            <BoxView
                HeightRequest="15"
                BackgroundColor="Transparent" />


        </VerticalStackLayout>

    </ScrollView>

</ContentPage>