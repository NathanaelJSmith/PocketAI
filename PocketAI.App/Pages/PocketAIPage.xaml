<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketAI.App.Pages.PocketAIPage"
    BackgroundColor="#F5F7FA"
    Shell.NavBarIsVisible="False"
    Title="PocketAI">


    <Grid
        RowDefinitions="Auto,*,Auto"
        Padding="32,28,32,24"
        RowSpacing="20">


        <!-- ================================= -->
        <!-- HEADER                            -->
        <!-- ================================= -->

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="5">

                <Label
                    Text="POCKETAI"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#111827" />

                <Label
                    Text="Your personal financial coach."
                    FontSize="14"
                    TextColor="#6B7280" />

            </VerticalStackLayout>


            <!-- STATUS -->

            <Border
                Grid.Column="1"
                BackgroundColor="#ECFDF5"
                Stroke="#A7F3D0"
                StrokeThickness="1"
                Padding="12,7"
                VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <HorizontalStackLayout
                    Spacing="7">

                    <BoxView
                        WidthRequest="8"
                        HeightRequest="8"
                        CornerRadius="4"
                        Color="#10B981"
                        VerticalOptions="Center" />

                    <Label
                        Text="Financial data connected"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#047857"
                        VerticalTextAlignment="Center" />

                </HorizontalStackLayout>

            </Border>

        </Grid>



        <!-- ================================= -->
        <!-- MAIN ASSISTANT AREA               -->
        <!-- ================================= -->

        <ScrollView
            x:Name="ConversationScrollView"
            Grid.Row="1">

            <VerticalStackLayout
                Spacing="20">


                <!-- ================================= -->
                <!-- POCKETAI WELCOME CARD             -->
                <!-- ================================= -->

                <Border
                    BackgroundColor="#F5F3FF"
                    Stroke="#DDD6FE"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>


                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="18">


                        <!-- AI ICON -->

                        <Border
                            Grid.Column="0"
                            WidthRequest="52"
                            HeightRequest="52"
                            BackgroundColor="#7C3AED"
                            StrokeThickness="0"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Label
                                Text="✦"
                                FontSize="25"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>



                        <!-- WELCOME TEXT -->

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="7">

                            <Label
                                Text="How can I help with your money?"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="#111827" />

                            <Label
                                Text="I can analyze your spending, budgets, savings goals, bills, and financial trends using the information already inside PocketAI."
                                FontSize="14"
                                LineHeight="1.3"
                                TextColor="#4B5563" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>



                <!-- ================================= -->
                <!-- FINANCIAL SNAPSHOT                -->
                <!-- ================================= -->

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="YOUR FINANCIAL SNAPSHOT"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#6B7280" />


                    <Grid
                        ColumnDefinitions="*,*,*,*"
                        ColumnSpacing="12">


                        <!-- SAFE TO SPEND -->

                        <Border
                            Grid.Column="0"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="16">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    Text="SAFE TO SPEND"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="#6B7280" />

                                <Label
                                    x:Name="SnapshotSafeToSpendLabel"
                                    Text="$0.00"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="#111827" />

                            </VerticalStackLayout>

                        </Border>



                        <!-- MONEY LEFT -->

                        <Border
                            Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="16">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    Text="MONEY LEFT"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="#6B7280" />

                                <Label
                                    x:Name="SnapshotMoneyLeftLabel"
                                    Text="$0.00"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="#111827" />

                            </VerticalStackLayout>

                        </Border>



                        <!-- MONTH SPENDING -->

                        <Border
                            Grid.Column="2"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="16">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    Text="SPENT"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="#6B7280" />

                                <Label
                                    x:Name="SnapshotSpentLabel"
                                    Text="$0.00"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="#111827" />

                            </VerticalStackLayout>

                        </Border>



                        <!-- FINANCIAL HEALTH -->

                        <Border
                            Grid.Column="3"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="16">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    Text="HEALTH"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="#6B7280" />

                                <Label
                                    x:Name="SnapshotHealthLabel"
                                    Text="-- / 100"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="#111827" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                </VerticalStackLayout>



                <!-- ================================= -->
                <!-- QUICK QUESTIONS                   -->
                <!-- ================================= -->

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="QUICK QUESTIONS"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#6B7280" />


                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="12"
                        RowSpacing="12">


                        <!-- SAFE TO SPEND -->

                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Can I afford to spend today?"
                            Clicked="SafeToSpendQuestionClicked"
                            BackgroundColor="White"
                            BorderColor="#E5E7EB"
                            BorderWidth="1"
                            TextColor="#374151"
                            FontSize="13"
                            CornerRadius="12"
                            Padding="16"
                            HorizontalOptions="Fill" />



                        <!-- SPENDING -->

                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="Where am I spending the most?"
                            Clicked="SpendingQuestionClicked"
                            BackgroundColor="White"
                            BorderColor="#E5E7EB"
                            BorderWidth="1"
                            TextColor="#374151"
                            FontSize="13"
                            CornerRadius="12"
                            Padding="16"
                            HorizontalOptions="Fill" />



                        <!-- SAVINGS -->

                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="How are my savings goals?"
                            Clicked="SavingsQuestionClicked"
                            BackgroundColor="White"
                            BorderColor="#E5E7EB"
                            BorderWidth="1"
                            TextColor="#374151"
                            FontSize="13"
                            CornerRadius="12"
                            Padding="16"
                            HorizontalOptions="Fill" />



                        <!-- FOCUS -->

                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="What should I focus on?"
                            Clicked="FocusQuestionClicked"
                            BackgroundColor="White"
                            BorderColor="#E5E7EB"
                            BorderWidth="1"
                            TextColor="#374151"
                            FontSize="13"
                            CornerRadius="12"
                            Padding="16"
                            HorizontalOptions="Fill" />

                    </Grid>

                </VerticalStackLayout>



                <!-- ================================= -->
                <!-- CONVERSATION                      -->
                <!-- ================================= -->

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="CONVERSATION"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#6B7280" />


                    <Border
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        Padding="22"
                        MinimumHeightRequest="220">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            x:Name="ConversationContainer"
                            Spacing="16">


                            <!-- DEFAULT AI MESSAGE -->

                            <Grid
                                x:Name="WelcomeAssistantMessage"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">

                                <Border
                                    Grid.Column="0"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="#7C3AED"
                                    StrokeThickness="0"
                                    VerticalOptions="Start">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <Label
                                        Text="✦"
                                        FontSize="17"
                                        TextColor="White"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                                </Border>


                                <Border
                                    Grid.Column="1"
                                    BackgroundColor="#F9FAFB"
                                    Stroke="#E5E7EB"
                                    StrokeThickness="1"
                                    Padding="16">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>

                                    <Label
                                        x:Name="AssistantMessageLabel"
                                        Text="Ask me a question about your finances or choose one of the quick questions above."
                                        FontSize="14"
                                        LineHeight="1.35"
                                        TextColor="#374151" />

                                </Border>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>



        <!-- ================================= -->
        <!-- QUESTION INPUT                    -->
        <!-- ================================= -->

        <Border
            Grid.Row="2"
            BackgroundColor="White"
            Stroke="#D1D5DB"
            StrokeThickness="1"
            Padding="8">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>


            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10">


                <!-- QUESTION ENTRY -->

                <Entry
                    x:Name="QuestionEntry"
                    Grid.Column="0"
                    Placeholder="Ask PocketAI about your finances..."
                    PlaceholderColor="#9CA3AF"
                    TextColor="#111827"
                    BackgroundColor="Transparent"
                    FontSize="14"
                    ReturnType="Send"
                    Completed="QuestionEntryCompleted" />



                <!-- SEND BUTTON -->

                <Button
                    x:Name="AskButton"
                    Grid.Column="1"
                    Text="Ask PocketAI"
                    Clicked="AskButtonClicked"
                    BackgroundColor="#7C3AED"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="12"
                    Padding="18,10" />

            </Grid>

        </Border>

    </Grid>

</ContentPage>