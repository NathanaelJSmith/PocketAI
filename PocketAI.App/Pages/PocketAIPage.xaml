<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketAI.App.Pages.PocketAIPage"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="PocketAI">


    <Grid
        RowDefinitions="Auto,*,Auto"
        Padding="32,28,32,24"
        RowSpacing="20">


        <!-- =====================================
             HEADER
             ===================================== -->

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="20">


            <VerticalStackLayout
                Grid.Column="0"
                Spacing="5">

                <Label
                    Text="POCKETAI"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource ThemePrimary}" />

                <Label
                    Text="Your personal financial coach."
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextPrimary}" />

                <Label
                    Text="Ask questions about your spending, budgets, bills, savings, or financial plan."
                    FontSize="14"
                    TextColor="{DynamicResource TextSecondary}" />

            </VerticalStackLayout>



            <!-- =================================
                 DATA STATUS
                 ================================= -->

            <Border
                Grid.Column="1"
                BackgroundColor="{DynamicResource SurfaceBackground}"
                Stroke="{DynamicResource SuccessColor}"
                StrokeThickness="1"
                Padding="12,7"
                VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle
                        CornerRadius="20" />
                </Border.StrokeShape>


                <HorizontalStackLayout
                    Spacing="7">

                    <BoxView
                        WidthRequest="8"
                        HeightRequest="8"
                        CornerRadius="4"
                        Color="{DynamicResource SuccessColor}"
                        VerticalOptions="Center" />

                    <Label
                        Text="Financial data connected"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource SuccessColor}"
                        VerticalTextAlignment="Center" />

                </HorizontalStackLayout>

            </Border>

        </Grid>



        <!-- =====================================
             MAIN ASSISTANT AREA
             ===================================== -->

        <ScrollView
            x:Name="ConversationScrollView"
            Grid.Row="1">

            <VerticalStackLayout
                Spacing="20">


                <!-- =================================
                     WELCOME
                     ================================= -->

                <Border
                    BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                    Stroke="{DynamicResource ThemePrimaryLight}"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="18" />
                    </Border.StrokeShape>


                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="18">


                        <!-- AI ICON -->

                        <Border
                            Grid.Column="0"
                            WidthRequest="52"
                            HeightRequest="52"
                            BackgroundColor="{DynamicResource ThemePrimary}"
                            StrokeThickness="0"
                            VerticalOptions="Start">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="14" />
                            </Border.StrokeShape>


                            <Label
                                Text="✦"
                                FontSize="25"
                                TextColor="{DynamicResource TextOnPrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>



                        <!-- WELCOME TEXT -->

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="7">

                            <Label
                                Text="How can I help with your money?"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="I can analyze your spending, budgets, savings goals, bills, and financial trends using the information already inside PocketAI."
                                FontSize="14"
                                LineHeight="1.3"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>



                <!-- =================================
                     FINANCIAL SNAPSHOT
                     ================================= -->

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="YOUR FINANCIAL SNAPSHOT"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Grid
                        ColumnDefinitions="*,*,*,*"
                        ColumnSpacing="12">


                        <!-- SAFE TO SPEND -->

                        <Border
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="16">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="14" />
                            </Border.StrokeShape>


                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    Text="SAFE TO SPEND"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource ThemePrimary}" />

                                <Label
                                    x:Name="SnapshotSafeToSpendLabel"
                                    Text="$0.00"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                            </VerticalStackLayout>

                        </Border>



                        <!-- MONEY LEFT -->

                        <Border
                            Grid.Column="1"
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="16">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="14" />
                            </Border.StrokeShape>


                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    Text="MONEY LEFT"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource ThemePrimary}" />

                                <Label
                                    x:Name="SnapshotMoneyLeftLabel"
                                    Text="$0.00"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                            </VerticalStackLayout>

                        </Border>



                        <!-- SPENT -->

                        <Border
                            Grid.Column="2"
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="16">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="14" />
                            </Border.StrokeShape>


                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    Text="SPENT"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource ThemePrimary}" />

                                <Label
                                    x:Name="SnapshotSpentLabel"
                                    Text="$0.00"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                            </VerticalStackLayout>

                        </Border>



                        <!-- HEALTH -->

                        <Border
                            Grid.Column="3"
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="16">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="14" />
                            </Border.StrokeShape>


                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    Text="HEALTH"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource ThemePrimary}" />

                                <Label
                                    x:Name="SnapshotHealthLabel"
                                    Text="-- / 100"
                                    FontSize="21"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                </VerticalStackLayout>



                <!-- =================================
                     QUICK QUESTIONS
                     ================================= -->

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="QUICK QUESTIONS"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="12"
                        RowSpacing="12">


                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Can I afford to spend today?"
                            Clicked="SafeToSpendQuestionClicked"
                            BackgroundColor="{DynamicResource CardBackground}"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="1"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="13"
                            CornerRadius="12"
                            Padding="16"
                            HorizontalOptions="Fill" />


                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="Where am I spending the most?"
                            Clicked="SpendingQuestionClicked"
                            BackgroundColor="{DynamicResource CardBackground}"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="1"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="13"
                            CornerRadius="12"
                            Padding="16"
                            HorizontalOptions="Fill" />


                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="How are my savings goals?"
                            Clicked="SavingsQuestionClicked"
                            BackgroundColor="{DynamicResource CardBackground}"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="1"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="13"
                            CornerRadius="12"
                            Padding="16"
                            HorizontalOptions="Fill" />


                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="What should I focus on?"
                            Clicked="FocusQuestionClicked"
                            BackgroundColor="{DynamicResource CardBackground}"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="1"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="13"
                            CornerRadius="12"
                            Padding="16"
                            HorizontalOptions="Fill" />

                    </Grid>

                </VerticalStackLayout>



                <!-- =================================
                     CONVERSATION
                     ================================= -->

                <VerticalStackLayout
                    Spacing="10">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <Label
                            Grid.Column="0"
                            Text="CONVERSATION"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextSecondary}" />

                        <Label
                            Grid.Column="1"
                            Text="PocketAI uses your financial data"
                            FontSize="10"
                            TextColor="{DynamicResource TextMuted}" />

                    </Grid>



                    <Border
                        BackgroundColor="{DynamicResource CardBackground}"
                        Stroke="{DynamicResource BorderColor}"
                        StrokeThickness="1"
                        Padding="22"
                        MinimumHeightRequest="220">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="16" />
                        </Border.StrokeShape>


                        <VerticalStackLayout
                            x:Name="ConversationContainer"
                            Spacing="16">


                            <!-- DEFAULT AI MESSAGE -->

                            <Grid
                                x:Name="WelcomeAssistantMessage"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">


                                <Border
                                    Grid.Column="0"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="{DynamicResource ThemePrimary}"
                                    StrokeThickness="0"
                                    VerticalOptions="Start">

                                    <Border.StrokeShape>
                                        <RoundRectangle
                                            CornerRadius="10" />
                                    </Border.StrokeShape>


                                    <Label
                                        Text="✦"
                                        FontSize="17"
                                        TextColor="{DynamicResource TextOnPrimary}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                                </Border>



                                <Border
                                    Grid.Column="1"
                                    BackgroundColor="{DynamicResource SurfaceBackground}"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeThickness="1"
                                    Padding="16">

                                    <Border.StrokeShape>
                                        <RoundRectangle
                                            CornerRadius="14" />
                                    </Border.StrokeShape>


                                    <Label
                                        x:Name="AssistantMessageLabel"
                                        Text="Ask me a question about your finances or choose one of the quick questions above."
                                        FontSize="14"
                                        LineHeight="1.35"
                                        TextColor="{DynamicResource TextPrimary}" />

                                </Border>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>



        <!-- =====================================
             QUESTION INPUT
             ===================================== -->

        <Border
            Grid.Row="2"
            BackgroundColor="{DynamicResource CardBackground}"
            Stroke="{DynamicResource BorderColor}"
            StrokeThickness="1"
            Padding="8">

            <Border.StrokeShape>
                <RoundRectangle
                    CornerRadius="16" />
            </Border.StrokeShape>


            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10">


                <Entry
                    x:Name="QuestionEntry"
                    Grid.Column="0"
                    Placeholder="Ask PocketAI about your finances..."
                    PlaceholderColor="{DynamicResource TextMuted}"
                    TextColor="{DynamicResource TextPrimary}"
                    BackgroundColor="Transparent"
                    FontSize="14"
                    ReturnType="Send"
                    Completed="QuestionEntryCompleted" />


                <Button
                    x:Name="AskButton"
                    Grid.Column="1"
                    Text="Ask PocketAI"
                    Clicked="AskButtonClicked"
                    BackgroundColor="{DynamicResource ThemePrimary}"
                    TextColor="{DynamicResource TextOnPrimary}"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="12"
                    Padding="18,10" />

            </Grid>

        </Border>

    </Grid>

</ContentPage>