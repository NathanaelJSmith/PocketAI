<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketAI.App.Pages.ProfilePage"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="Profile">


    <ScrollView>

        <VerticalStackLayout
            Padding="32"
            Spacing="24">


            <!-- =====================================
                 HEADER
                 ===================================== -->

            <VerticalStackLayout
                Spacing="5">

                <Label
                    Text="PROFILE"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource ThemePrimary}" />

                <Label
                    Text="Your PocketAI profile."
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextPrimary}" />

                <Label
                    Text="Manage your identity, preferences, and future PocketAI account features."
                    FontSize="14"
                    TextColor="{DynamicResource TextSecondary}" />

            </VerticalStackLayout>



            <!-- =====================================
                 PROFILE CARD
                 ===================================== -->

            <Border
                BackgroundColor="{DynamicResource CardBackground}"
                Stroke="{DynamicResource BorderColor}"
                StrokeThickness="1"
                Padding="26">

                <Border.StrokeShape>
                    <RoundRectangle
                        CornerRadius="18" />
                </Border.StrokeShape>


                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="20">


                    <!-- PROFILE ICON -->

                    <Border
                        Grid.Column="0"
                        WidthRequest="72"
                        HeightRequest="72"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        StrokeThickness="0"
                        VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle
                                CornerRadius="22" />
                        </Border.StrokeShape>


                        <Label
                            Text="♙"
                            FontSize="30"
                            TextColor="{DynamicResource TextOnPrimary}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>



                    <!-- PROFILE INFORMATION -->

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="6"
                        VerticalOptions="Center">

                        <Label
                            Text="PocketAI User"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />

                        <Label
                            Text="Local Profile"
                            FontSize="13"
                            TextColor="{DynamicResource TextSecondary}" />


                        <Border
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="10,5"
                            HorizontalOptions="Start"
                            Margin="0,3,0,0">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="10" />
                            </Border.StrokeShape>


                            <Label
                                Text="PocketAI Member"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                        </Border>

                    </VerticalStackLayout>

                </Grid>

            </Border>



            <!-- =====================================
                 PROFILE SECTIONS
                 ===================================== -->

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="16">


                <!-- =================================
                     ACCOUNT
                     ================================= -->

                <Border
                    Grid.Column="0"
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="22">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="16" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="14">


                        <Border
                            WidthRequest="44"
                            HeightRequest="44"
                            HorizontalOptions="Start"
                            BackgroundColor="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="12" />
                            </Border.StrokeShape>


                            <Label
                                Text="◎"
                                FontSize="18"
                                TextColor="{DynamicResource ThemePrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>


                        <VerticalStackLayout
                            Spacing="4">

                            <Label
                                Text="Account"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Sign-in and cloud account features will be added as PocketAI grows."
                                FontSize="12"
                                LineHeight="1.3"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>



                <!-- =================================
                     PERSONALIZATION
                     ================================= -->

                <Border
                    Grid.Column="1"
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="22">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="16" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="14">


                        <Border
                            WidthRequest="44"
                            HeightRequest="44"
                            HorizontalOptions="Start"
                            BackgroundColor="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="12" />
                            </Border.StrokeShape>


                            <Label
                                Text="✦"
                                FontSize="18"
                                TextColor="{DynamicResource ThemePrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>


                        <VerticalStackLayout
                            Spacing="4">

                            <Label
                                Text="Personalization"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Your appearance preferences are currently managed from Settings."
                                FontSize="12"
                                LineHeight="1.3"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </Grid>



            <!-- =====================================
                 FUTURE PROFILE FEATURES
                 ===================================== -->

            <Border
                BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                Stroke="{DynamicResource ThemePrimaryLight}"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle
                        CornerRadius="16" />
                </Border.StrokeShape>


                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="15">


                    <Label
                        Grid.Column="0"
                        Text="✦"
                        FontSize="20"
                        TextColor="{DynamicResource ThemePrimary}"
                        VerticalOptions="Start" />


                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="5">

                        <Label
                            Text="More profile control is coming"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />

                        <Label
                            Text="Future versions can add account sign-in, profile details, cloud sync, notification preferences, and deeper personalization."
                            FontSize="12"
                            LineHeight="1.3"
                            TextColor="{DynamicResource TextSecondary}" />

                    </VerticalStackLayout>

                </Grid>

            </Border>



            <BoxView
                HeightRequest="15"
                BackgroundColor="Transparent" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>