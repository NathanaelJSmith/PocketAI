<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketAI.App.Pages.SavingsPage"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False">

    <Grid>


        <!-- =====================================
             MAIN PAGE
             ===================================== -->

        <ScrollView>

            <VerticalStackLayout
                Padding="32"
                Spacing="24">


                <!-- =================================
                     HEADER
                     ================================= -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="20">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="5">

                        <Label
                            Text="SAVINGS"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemePrimary}" />

                        <Label
                            Text="Build your goals one step at a time."
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />

                        <Label
                            Text="Track progress, know what you need each week, and keep your priorities clear."
                            FontSize="14"
                            TextColor="{DynamicResource TextSecondary}" />

                    </VerticalStackLayout>


                    <Button
                        Grid.Column="1"
                        Text="+ Add Goal"
                        Clicked="ShowAddGoalClicked"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        Padding="18,12"
                        VerticalOptions="Center" />

                </Grid>



                <!-- =================================
                     SUMMARY
                     ================================= -->

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="YOUR SAVINGS"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Grid
                        ColumnDefinitions="*,*,*,*"
                        ColumnSpacing="14">


                        <!-- TOTAL SAVED -->

                        <Border
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="20">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="16" />
                            </Border.StrokeShape>

                            <VerticalStackLayout
                                Spacing="7">

                                <Label
                                    Text="TOTAL SAVED"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource ThemePrimary}" />

                                <Label
                                    x:Name="TotalSavedLabel"
                                    Text="$0.00"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                                <Label
                                    Text="Across all goals"
                                    FontSize="11"
                                    TextColor="{DynamicResource TextMuted}" />

                            </VerticalStackLayout>

                        </Border>



                        <!-- TOTAL TARGET -->

                        <Border
                            Grid.Column="1"
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="20">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="16" />
                            </Border.StrokeShape>

                            <VerticalStackLayout
                                Spacing="7">

                                <Label
                                    Text="TOTAL TARGET"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource ThemePrimary}" />

                                <Label
                                    x:Name="TotalTargetLabel"
                                    Text="$0.00"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                                <Label
                                    Text="Combined goal value"
                                    FontSize="11"
                                    TextColor="{DynamicResource TextMuted}" />

                            </VerticalStackLayout>

                        </Border>



                        <!-- REMAINING -->

                        <Border
                            Grid.Column="2"
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="20">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="16" />
                            </Border.StrokeShape>

                            <VerticalStackLayout
                                Spacing="7">

                                <Label
                                    Text="REMAINING"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource ThemePrimary}" />

                                <Label
                                    x:Name="TotalRemainingLabel"
                                    Text="$0.00"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                                <Label
                                    Text="Still needed"
                                    FontSize="11"
                                    TextColor="{DynamicResource TextMuted}" />

                            </VerticalStackLayout>

                        </Border>



                        <!-- GOALS -->

                        <Border
                            Grid.Column="3"
                            BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                            Stroke="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="1"
                            Padding="20">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="16" />
                            </Border.StrokeShape>

                            <VerticalStackLayout
                                Spacing="7">

                                <Label
                                    Text="GOALS"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource ThemePrimary}" />

                                <Label
                                    x:Name="GoalCountLabel"
                                    Text="0"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                                <Label
                                    Text="Active savings plans"
                                    FontSize="11"
                                    TextColor="{DynamicResource TextMuted}" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                </VerticalStackLayout>



                <!-- =================================
                     EMPTY STATE
                     ================================= -->

                <Border
                    x:Name="SavingsEmptyState"
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="45"
                    IsVisible="False">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="16" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="12">


                        <Border
                            WidthRequest="54"
                            HeightRequest="54"
                            BackgroundColor="{DynamicResource ThemePrimaryLight}"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="17" />
                            </Border.StrokeShape>

                            <Label
                                Text="◎"
                                FontSize="23"
                                TextColor="{DynamicResource ThemePrimary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>


                        <Label
                            Text="No savings goals yet"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}"
                            HorizontalTextAlignment="Center" />


                        <Label
                            Text="Create your first goal and PocketAI will help you understand the progress."
                            FontSize="14"
                            TextColor="{DynamicResource TextSecondary}"
                            HorizontalTextAlignment="Center" />


                        <Button
                            Text="+ Create Goal"
                            Clicked="ShowAddGoalClicked"
                            BackgroundColor="{DynamicResource ThemePrimary}"
                            TextColor="{DynamicResource TextOnPrimary}"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            Margin="0,8,0,0"
                            HorizontalOptions="Center" />

                    </VerticalStackLayout>

                </Border>



                <!-- =================================
                     SAVINGS GOALS
                     ================================= -->

                <VerticalStackLayout
                    Spacing="12">


                    <VerticalStackLayout
                        Spacing="3">

                        <Label
                            Text="Your Goals"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />

                        <Label
                            Text="Your primary goal is the one PocketAI should treat as your top savings priority."
                            FontSize="12"
                            TextColor="{DynamicResource TextSecondary}" />

                    </VerticalStackLayout>



                    <VerticalStackLayout
                        x:Name="SavingsGoalsContainer"
                        Spacing="14">


                        <BindableLayout.ItemTemplate>

                            <DataTemplate>


                                <!-- =========================
                                     SAVINGS GOAL CARD
                                     ========================= -->

                                <Border
                                    BackgroundColor="{DynamicResource CardBackground}"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeThickness="1"
                                    Padding="24">

                                    <Border.StrokeShape>
                                        <RoundRectangle
                                            CornerRadius="16" />
                                    </Border.StrokeShape>


                                    <VerticalStackLayout
                                        Spacing="17">


                                        <!-- =================
                                             GOAL HEADER
                                             ================= -->

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="20">


                                            <VerticalStackLayout
                                                Grid.Column="0"
                                                Spacing="5">


                                                <HorizontalStackLayout
                                                    Spacing="10">


                                                    <Label
                                                        Text="{Binding Name}"
                                                        FontSize="19"
                                                        FontAttributes="Bold"
                                                        TextColor="{DynamicResource TextPrimary}"
                                                        VerticalOptions="Center" />



                                                    <!-- PRIMARY BADGE -->

                                                    <Border
                                                        IsVisible="{Binding IsPrimary}"
                                                        BackgroundColor="{DynamicResource ThemePrimaryLight}"
                                                        StrokeThickness="0"
                                                        Padding="9,3"
                                                        VerticalOptions="Center">

                                                        <Border.StrokeShape>
                                                            <RoundRectangle
                                                                CornerRadius="8" />
                                                        </Border.StrokeShape>


                                                        <Label
                                                            Text="★ PRIMARY"
                                                            FontSize="10"
                                                            FontAttributes="Bold"
                                                            TextColor="{DynamicResource ThemePrimary}" />

                                                    </Border>

                                                </HorizontalStackLayout>



                                                <Label
                                                    Text="{Binding DeadlineText}"
                                                    FontSize="13"
                                                    TextColor="{DynamicResource TextSecondary}" />

                                            </VerticalStackLayout>



                                            <!-- CURRENT / TARGET -->

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                HorizontalOptions="End"
                                                Spacing="4">

                                                <Label
                                                    Text="{Binding AmountText}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextPrimary}"
                                                    HorizontalTextAlignment="End" />

                                                <Label
                                                    Text="{Binding PercentText}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource ThemePrimary}"
                                                    HorizontalTextAlignment="End" />

                                            </VerticalStackLayout>

                                        </Grid>



                                        <!-- =================
                                             PROGRESS
                                             ================= -->

                                        <ProgressBar
                                            Progress="{Binding Progress}"
                                            ProgressColor="{DynamicResource ThemePrimary}"
                                            BackgroundColor="{DynamicResource BorderColor}"
                                            HeightRequest="9" />



                                        <!-- =================
                                             GOAL DETAILS
                                             ================= -->

                                        <Grid
                                            ColumnDefinitions="*,*,*"
                                            ColumnSpacing="20">


                                            <!-- REMAINING -->

                                            <VerticalStackLayout
                                                Grid.Column="0"
                                                Spacing="3">

                                                <Label
                                                    Text="REMAINING"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextMuted}" />

                                                <Label
                                                    Text="{Binding RemainingText}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextPrimary}" />

                                            </VerticalStackLayout>



                                            <!-- TIME LEFT -->

                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="3">

                                                <Label
                                                    Text="TIME LEFT"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextMuted}" />

                                                <Label
                                                    Text="{Binding DaysLeftText}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextPrimary}" />

                                            </VerticalStackLayout>



                                            <!-- NEEDED PER WEEK -->

                                            <VerticalStackLayout
                                                Grid.Column="2"
                                                Spacing="3">

                                                <Label
                                                    Text="NEEDED / WEEK"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextMuted}" />

                                                <Label
                                                    Text="{Binding WeeklyNeededText}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{DynamicResource TextPrimary}" />

                                            </VerticalStackLayout>

                                        </Grid>



                                        <!-- =================
                                             STATUS
                                             ================= -->

                                        <Border
                                            BackgroundColor="{DynamicResource SurfaceBackground}"
                                            Stroke="{DynamicResource BorderColor}"
                                            StrokeThickness="1"
                                            Padding="12">

                                            <Border.StrokeShape>
                                                <RoundRectangle
                                                    CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <Label
                                                Text="{Binding StatusText}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                TextColor="{Binding StatusColor}" />

                                        </Border>



                                        <!-- =================
                                             ACTIONS
                                             ================= -->

                                        <HorizontalStackLayout
                                            Spacing="10"
                                            HorizontalOptions="End">


                                            <Button
                                                Text="Make Primary"
                                                IsVisible="{Binding CanMakePrimary}"
                                                Clicked="MakePrimaryClicked"
                                                BackgroundColor="{DynamicResource SurfaceBackground}"
                                                TextColor="{DynamicResource ThemePrimary}"
                                                BorderColor="{DynamicResource ThemePrimary}"
                                                BorderWidth="1"
                                                FontAttributes="Bold"
                                                CornerRadius="9"
                                                Padding="14,8" />


                                            <Button
                                                Text="+ Add Savings"
                                                Clicked="ShowAddSavingsClicked"
                                                BackgroundColor="{DynamicResource ThemePrimary}"
                                                TextColor="{DynamicResource TextOnPrimary}"
                                                FontAttributes="Bold"
                                                CornerRadius="9"
                                                Padding="14,8" />


                                            <Button
                                                Text="Edit"
                                                Clicked="ShowEditGoalClicked"
                                                BackgroundColor="{DynamicResource SurfaceBackground}"
                                                TextColor="{DynamicResource TextPrimary}"
                                                BorderColor="{DynamicResource BorderColor}"
                                                BorderWidth="1"
                                                FontAttributes="Bold"
                                                CornerRadius="9"
                                                Padding="14,8" />

                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>



                <!-- BOTTOM SPACE -->

                <BoxView
                    HeightRequest="15"
                    BackgroundColor="Transparent" />

            </VerticalStackLayout>

        </ScrollView>



        <!-- =====================================
             MODAL BACKGROUND
             ===================================== -->

        <BoxView
            x:Name="ModalBackground"
            ZIndex="10"
            BackgroundColor="#90000000"
            IsVisible="False">

            <BoxView.GestureRecognizers>

                <TapGestureRecognizer
                    Tapped="CloseSavingsModalsClicked" />

            </BoxView.GestureRecognizers>

        </BoxView>



        <!-- =====================================
             CREATE / EDIT GOAL MODAL
             ===================================== -->

        <Border
            x:Name="GoalModal"
            ZIndex="20"
            IsVisible="False"
            BackgroundColor="{DynamicResource CardBackground}"
            Stroke="{DynamicResource BorderColor}"
            StrokeThickness="1"
            Padding="28"
            WidthRequest="460"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Border.StrokeShape>
                <RoundRectangle
                    CornerRadius="18" />
            </Border.StrokeShape>


            <VerticalStackLayout
                Spacing="17">


                <!-- MODAL HEADER -->

                <VerticalStackLayout
                    Spacing="4">

                    <Label
                        x:Name="GoalModalTitleLabel"
                        Text="ADD SAVINGS GOAL"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimary}" />

                    <Label
                        Text="Create a target so PocketAI can help track the plan."
                        FontSize="12"
                        TextColor="{DynamicResource TextSecondary}" />

                </VerticalStackLayout>



                <!-- NAME -->

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="Goal Name"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />

                    <Entry
                        x:Name="GoalNameEntry"
                        Placeholder="Emergency Fund"
                        PlaceholderColor="{DynamicResource TextMuted}"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- TARGET -->

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="Target Amount"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />

                    <Entry
                        x:Name="GoalTargetEntry"
                        Placeholder="6000.00"
                        PlaceholderColor="{DynamicResource TextMuted}"
                        Keyboard="Numeric"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- CURRENT -->

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="Already Saved"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />

                    <Entry
                        x:Name="GoalCurrentEntry"
                        Placeholder="0.00"
                        PlaceholderColor="{DynamicResource TextMuted}"
                        Keyboard="Numeric"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- DEADLINE -->

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="Target Date"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />

                    <DatePicker
                        x:Name="GoalDeadlinePicker"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- SAVE / CANCEL -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Margin="0,8,0,0">

                    <Button
                        Grid.Column="0"
                        Text="Cancel"
                        Clicked="CancelSavingsModalClicked"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}"
                        BorderColor="{DynamicResource BorderColor}"
                        BorderWidth="1"
                        CornerRadius="10" />


                    <Button
                        x:Name="SaveGoalButton"
                        Grid.Column="1"
                        Text="Add Goal"
                        Clicked="SaveGoalClicked"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="10" />

                </Grid>



                <!-- DELETE -->

                <Button
                    x:Name="DeleteGoalButton"
                    Text="Delete Goal"
                    Clicked="DeleteGoalClicked"
                    BackgroundColor="{DynamicResource DangerBackground}"
                    TextColor="{DynamicResource DangerColor}"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    IsVisible="False" />

            </VerticalStackLayout>

        </Border>



        <!-- =====================================
             ADD SAVINGS MODAL
             ===================================== -->

        <Border
            x:Name="AddSavingsModal"
            ZIndex="30"
            IsVisible="False"
            BackgroundColor="{DynamicResource CardBackground}"
            Stroke="{DynamicResource BorderColor}"
            StrokeThickness="1"
            Padding="28"
            WidthRequest="420"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Border.StrokeShape>
                <RoundRectangle
                    CornerRadius="18" />
            </Border.StrokeShape>


            <VerticalStackLayout
                Spacing="18">


                <!-- HEADER -->

                <VerticalStackLayout
                    Spacing="4">

                    <Label
                        Text="ADD SAVINGS"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimary}" />

                    <Label
                        x:Name="AddSavingsGoalNameLabel"
                        Text="Savings Goal"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource ThemePrimary}" />

                </VerticalStackLayout>



                <!-- AMOUNT -->

                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="Amount"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />

                    <Entry
                        x:Name="AddSavingsAmountEntry"
                        Placeholder="100.00"
                        PlaceholderColor="{DynamicResource TextMuted}"
                        Keyboard="Numeric"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- BUTTONS -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">

                    <Button
                        Grid.Column="0"
                        Text="Cancel"
                        Clicked="CancelSavingsModalClicked"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}"
                        BorderColor="{DynamicResource BorderColor}"
                        BorderWidth="1"
                        CornerRadius="10" />


                    <Button
                        Grid.Column="1"
                        Text="Add Savings"
                        Clicked="AddSavingsClicked"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="10" />

                </Grid>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>