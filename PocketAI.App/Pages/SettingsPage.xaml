<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketAI.App.Pages.SettingsPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource PageBackground}"
    Title="Settings">


    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="24">


            <!-- =====================================
                 PAGE HEADER
                 ===================================== -->

            <VerticalStackLayout
                Spacing="6">

                <Label
                    Text="Settings"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextPrimary}" />

                <Label
                    Text="Personalize BudgetAI and control how the app works for you."
                    FontSize="15"
                    TextColor="{DynamicResource TextSecondary}" />

            </VerticalStackLayout>



            <!-- =====================================
                 APPEARANCE
                 ===================================== -->

            <VerticalStackLayout
                Spacing="10">

                <Label
                    Text="APPEARANCE"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextSecondary}" />


                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="22">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="18" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="22">


                        <!-- =================================
                             HEADER
                             ================================= -->

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="14">


                            <Border
                                WidthRequest="46"
                                HeightRequest="46"
                                BackgroundColor="{DynamicResource ThemePrimaryLight}"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle
                                        CornerRadius="13" />
                                </Border.StrokeShape>


                                <Label
                                    Text="✦"
                                    FontSize="20"
                                    TextColor="{DynamicResource ThemePrimary}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>


                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="3">

                                <Label
                                    Text="App Appearance"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />

                                <Label
                                    Text="Make BudgetAI feel like your app."
                                    FontSize="13"
                                    TextColor="{DynamicResource TextSecondary}" />

                            </VerticalStackLayout>

                        </Grid>



                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{DynamicResource BorderColor}" />



                        <!-- =================================
                             THEME PREVIEW
                             ================================= -->

                        <VerticalStackLayout
                            Spacing="10">


                            <Label
                                Text="Preview"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />


                            <Border
                                BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                                Stroke="{DynamicResource ThemePrimaryLight}"
                                StrokeThickness="1"
                                Padding="18">

                                <Border.StrokeShape>
                                    <RoundRectangle
                                        CornerRadius="14" />
                                </Border.StrokeShape>


                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    RowDefinitions="Auto,Auto"
                                    RowSpacing="5">


                                    <Label
                                        Text="Safe to Spend"
                                        FontSize="13"
                                        TextColor="{DynamicResource TextSecondary}" />


                                    <Label
                                        Grid.Row="1"
                                        Text="$428.50"
                                        FontSize="24"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource ThemePrimary}" />


                                    <Border
                                        Grid.Column="1"
                                        Grid.RowSpan="2"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        BackgroundColor="{DynamicResource ThemePrimary}"
                                        StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle
                                                CornerRadius="12" />
                                        </Border.StrokeShape>


                                        <Label
                                            Text="$"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />

                                    </Border>

                                </Grid>

                            </Border>

                        </VerticalStackLayout>

                        <!-- =================================
                            DISPLAY MODE
                            ================================= -->

                        <VerticalStackLayout
                            Spacing="10">

                            <Label
                                Text="Display Mode"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Choose a light theme, dark theme, or follow your device."
                                FontSize="12"
                                TextColor="{DynamicResource TextSecondary}" />


                            <HorizontalStackLayout
                                Spacing="10">

                                <Button
                                    Text="☀ Light"
                                    BackgroundColor="{DynamicResource SurfaceBackground}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    BorderWidth="1"
                                    CornerRadius="12"
                                    Padding="18,10"
                                    Clicked="LightModeClicked" />

                                <Button
                                    Text="☾ Dark"
                                    BackgroundColor="{DynamicResource SurfaceBackground}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    BorderWidth="1"
                                    CornerRadius="12"
                                    Padding="18,10"
                                    Clicked="DarkModeClicked" />

                                <Button
                                    Text="◐ System"
                                    BackgroundColor="{DynamicResource SurfaceBackground}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    BorderColor="{DynamicResource BorderColor}"
                                    BorderWidth="1"
                                    CornerRadius="12"
                                    Padding="18,10"
                                    Clicked="SystemModeClicked" />

                            </HorizontalStackLayout>


                            <Label
                                x:Name="CurrentDisplayModeLabel"
                                Text="Current mode: Light"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource ThemePrimary}" />

                        </VerticalStackLayout>


                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{DynamicResource BorderColor}" />


                        <!-- =================================
                             ACCENT COLOR TITLE
                             ================================= -->

                        <VerticalStackLayout
                            Spacing="3">

                            <Label
                                Text="Accent Color"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextPrimary}" />

                            <Label
                                Text="Choose the main color used throughout BudgetAI."
                                FontSize="12"
                                TextColor="{DynamicResource TextSecondary}" />

                        </VerticalStackLayout>



                        <!-- =================================
                             COLOR OPTIONS
                             ================================= -->

                        <FlexLayout
                            Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start">


                            <!-- PURPLE -->

                            <Button
                                Text="Purple"
                                BackgroundColor="#7C3AED"
                                TextColor="White"
                                CornerRadius="12"
                                Margin="0,0,10,10"
                                Padding="18,10"
                                Clicked="PurpleThemeClicked" />


                            <!-- BLUE -->

                            <Button
                                Text="Blue"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                CornerRadius="12"
                                Margin="0,0,10,10"
                                Padding="18,10"
                                Clicked="BlueThemeClicked" />


                            <!-- GREEN -->

                            <Button
                                Text="Green"
                                BackgroundColor="#16A34A"
                                TextColor="White"
                                CornerRadius="12"
                                Margin="0,0,10,10"
                                Padding="18,10"
                                Clicked="GreenThemeClicked" />


                            <!-- TEAL -->

                            <Button
                                Text="Teal"
                                BackgroundColor="#0D9488"
                                TextColor="White"
                                CornerRadius="12"
                                Margin="0,0,10,10"
                                Padding="18,10"
                                Clicked="TealThemeClicked" />


                            <!-- ORANGE -->

                            <Button
                                Text="Orange"
                                BackgroundColor="#EA580C"
                                TextColor="White"
                                CornerRadius="12"
                                Margin="0,0,10,10"
                                Padding="18,10"
                                Clicked="OrangeThemeClicked" />


                            <!-- PINK -->

                            <Button
                                Text="Pink"
                                BackgroundColor="#DB2777"
                                TextColor="White"
                                CornerRadius="12"
                                Margin="0,0,10,10"
                                Padding="18,10"
                                Clicked="PinkThemeClicked" />


                            <!-- RED -->

                            <Button
                                Text="Red"
                                BackgroundColor="#DC2626"
                                TextColor="White"
                                CornerRadius="12"
                                Margin="0,0,10,10"
                                Padding="18,10"
                                Clicked="RedThemeClicked" />

                        </FlexLayout>



                        <!-- =================================
                             CURRENT THEME
                             ================================= -->

                        <Border
                            BackgroundColor="{DynamicResource SurfaceBackground}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeThickness="1"
                            Padding="14">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="12" />
                            </Border.StrokeShape>


                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="12">


                                <Border
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    BackgroundColor="{DynamicResource ThemePrimary}"
                                    StrokeThickness="0">

                                    <Border.StrokeShape>
                                        <RoundRectangle
                                            CornerRadius="15" />
                                    </Border.StrokeShape>

                                </Border>


                                <VerticalStackLayout
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Spacing="0">

                                    <Label
                                        Text="Current Theme"
                                        FontSize="11"
                                        TextColor="{DynamicResource TextSecondary}" />

                                    <Label
                                        x:Name="CurrentThemeLabel"
                                        Text="Purple"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource TextPrimary}" />

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>



            <!-- =====================================
                 MORE CONTROL
                 ===================================== -->

            <VerticalStackLayout
                Spacing="10">

                <Label
                    Text="MORE CONTROL"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextSecondary}" />


                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="20">

                    <Border.StrokeShape>
                        <RoundRectangle
                            CornerRadius="18" />
                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="More personalization is coming"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />

                        <Label
                            Text="Next we'll add display mode, BudgetAI coaching preferences, notification controls, and more ways to personalize your financial experience."
                            FontSize="13"
                            LineHeight="1.3"
                            TextColor="{DynamicResource TextSecondary}" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>


        </VerticalStackLayout>

    </ScrollView>

</ContentPage>