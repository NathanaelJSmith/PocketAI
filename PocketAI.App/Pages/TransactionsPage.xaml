<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketAI.App.Pages.TransactionsPage"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False">


    <Grid>


        <!-- =====================================
             MAIN TRANSACTIONS PAGE
             ===================================== -->

        <ScrollView>

            <VerticalStackLayout
                Padding="32"
                Spacing="24">


                <!-- =================================
                     HEADER
                     ================================= -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="20">


                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="5">


                        <Label
                            Text="TRANSACTIONS"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemePrimary}" />


                        <Label
                            Text="Track and manage your spending."
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}"
                            Margin="0,2,0,0" />


                        <Label
                            Text="See where your money went, which account paid for it, and how each purchase affects your budget."
                            FontSize="14"
                            TextColor="{DynamicResource TextSecondary}" />

                    </VerticalStackLayout>



                    <Button
                        Grid.Column="1"
                        Text="+ Add Expense"
                        Clicked="ShowAddExpenseClicked"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        Padding="18,12"
                        VerticalOptions="Center" />

                </Grid>



                <!-- =================================
                     THIS MONTH
                     ================================= -->

                <Border
                    BackgroundColor="{DynamicResource ThemePrimaryVeryLight}"
                    Stroke="{DynamicResource ThemePrimaryLight}"
                    StrokeThickness="1"
                    Padding="20"
                    WidthRequest="280"
                    HorizontalOptions="Start">

                    <Border.StrokeShape>

                        <RoundRectangle
                            CornerRadius="16" />

                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="7">


                        <Label
                            Text="SPENT THIS MONTH"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource ThemePrimary}" />


                        <Label
                            x:Name="ThisMonthTotalLabel"
                            Text="$0.00"
                            FontSize="32"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource TextPrimary}" />


                        <Label
                            Text="Total recorded expenses"
                            FontSize="11"
                            TextColor="{DynamicResource TextMuted}" />

                    </VerticalStackLayout>

                </Border>



                <!-- =================================
                     SEARCH AND FILTERS
                     ================================= -->

                <VerticalStackLayout
                    Spacing="10">


                    <Label
                        Text="FIND TRANSACTIONS"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Grid
                        ColumnDefinitions="2*,*,*"
                        ColumnSpacing="12">


                        <!-- SEARCH -->

                        <SearchBar
                            x:Name="TransactionSearchBar"
                            Grid.Column="0"
                            Placeholder="Search transactions..."
                            TextChanged="TransactionSearchChanged"
                            BackgroundColor="{DynamicResource CardBackground}"
                            TextColor="{DynamicResource TextPrimary}"
                            PlaceholderColor="{DynamicResource TextMuted}" />



                        <!-- CATEGORY -->

                        <Picker
                            x:Name="CategoryPicker"
                            Grid.Column="1"
                            Title="All Categories"
                            TitleColor="{DynamicResource TextMuted}"
                            SelectedIndexChanged="FilterChanged"
                            BackgroundColor="{DynamicResource CardBackground}"
                            TextColor="{DynamicResource TextPrimary}" />



                        <!-- MONTH -->

                        <Picker
                            x:Name="MonthPicker"
                            Grid.Column="2"
                            Title="Month"
                            TitleColor="{DynamicResource TextMuted}"
                            SelectedIndexChanged="FilterChanged"
                            BackgroundColor="{DynamicResource CardBackground}"
                            TextColor="{DynamicResource TextPrimary}" />

                    </Grid>

                </VerticalStackLayout>



                <!-- =================================
                     TRANSACTION TABLE
                     ================================= -->

                <Border
                    BackgroundColor="{DynamicResource CardBackground}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeThickness="1"
                    Padding="0">

                    <Border.StrokeShape>

                        <RoundRectangle
                            CornerRadius="16" />

                    </Border.StrokeShape>


                    <VerticalStackLayout
                        Spacing="0">


                        <!-- =================================
                             TABLE TITLE
                             ================================= -->

                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="18,16"
                            BackgroundColor="{DynamicResource CardBackground}">


                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="2">


                                <Label
                                    Text="Transaction History"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource TextPrimary}" />


                                <Label
                                    Text="Select a transaction to view, edit, or delete it."
                                    FontSize="11"
                                    TextColor="{DynamicResource TextMuted}" />

                            </VerticalStackLayout>

                        </Grid>



                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{DynamicResource BorderColor}" />



                        <!-- =================================
                             TABLE HEADER
                             ================================= -->

                        <Grid
                            ColumnDefinitions="110,2*,1.4*,1.2*,120"
                            Padding="18,14"
                            BackgroundColor="{DynamicResource SurfaceBackground}">


                            <Label
                                Grid.Column="0"
                                Text="DATE"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                Grid.Column="1"
                                Text="NAME"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                Grid.Column="2"
                                Text="CATEGORY"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                Grid.Column="3"
                                Text="PAID FROM"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}" />


                            <Label
                                Grid.Column="4"
                                Text="AMOUNT"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource TextSecondary}"
                                HorizontalTextAlignment="End" />

                        </Grid>



                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{DynamicResource BorderColor}" />



                        <!-- =================================
                             EMPTY STATE
                             ================================= -->

                        <Label
                            x:Name="NoTransactionsLabel"
                            Text="No transactions yet."
                            FontSize="14"
                            TextColor="{DynamicResource TextSecondary}"
                            HorizontalOptions="Center"
                            Margin="0,35"
                            IsVisible="True" />



                        <!-- =================================
                             TRANSACTIONS
                             ================================= -->

                        <CollectionView
                            x:Name="TransactionsCollectionView"
                            BackgroundColor="Transparent"
                            SelectionMode="Single"
                            SelectionChanged="TransactionSelected">


                            <CollectionView.ItemTemplate>

                                <DataTemplate>


                                    <VerticalStackLayout
                                        Spacing="0">


                                        <Grid
                                            ColumnDefinitions="110,2*,1.4*,1.2*,120"
                                            Padding="18,15">


                                            <!-- DATE -->

                                            <Label
                                                Grid.Column="0"
                                                Text="{Binding DateText}"
                                                FontSize="14"
                                                TextColor="{DynamicResource TextSecondary}"
                                                VerticalOptions="Center" />



                                            <!-- NAME -->

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Name}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource TextPrimary}"
                                                VerticalOptions="Center" />



                                            <!-- CATEGORY -->

                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding Category}"
                                                FontSize="14"
                                                TextColor="{DynamicResource TextSecondary}"
                                                VerticalOptions="Center" />



                                            <!-- PAID FROM -->

                                            <Label
                                                Grid.Column="3"
                                                Text="{Binding PaidFromText}"
                                                FontSize="14"
                                                TextColor="{DynamicResource TextSecondary}"
                                                VerticalOptions="Center" />



                                            <!-- AMOUNT -->

                                            <Label
                                                Grid.Column="4"
                                                Text="{Binding AmountText}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource TextPrimary}"
                                                HorizontalTextAlignment="End"
                                                VerticalOptions="Center" />

                                        </Grid>



                                        <BoxView
                                            HeightRequest="1"
                                            BackgroundColor="{DynamicResource BorderColor}"
                                            Opacity="0.65" />

                                    </VerticalStackLayout>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                </Border>



                <!-- BOTTOM SPACING -->

                <BoxView
                    HeightRequest="15"
                    BackgroundColor="Transparent" />

            </VerticalStackLayout>

        </ScrollView>



        <!-- =====================================
             MODAL BACKGROUND
             ===================================== -->

        <BoxView
            x:Name="ModalBackground"
            ZIndex="10"
            BackgroundColor="#90000000"
            IsVisible="False">


            <BoxView.GestureRecognizers>

                <TapGestureRecognizer
                    Tapped="CloseModalsClicked" />

            </BoxView.GestureRecognizers>

        </BoxView>



        <!-- =====================================
             ADD EXPENSE MODAL
             ===================================== -->

        <Border
            x:Name="AddExpenseModal"
            ZIndex="20"
            IsVisible="False"
            BackgroundColor="{DynamicResource CardBackground}"
            Stroke="{DynamicResource BorderColor}"
            StrokeThickness="1"
            Padding="28"
            WidthRequest="460"
            HorizontalOptions="Center"
            VerticalOptions="Center">


            <Border.StrokeShape>

                <RoundRectangle
                    CornerRadius="18" />

            </Border.StrokeShape>


            <VerticalStackLayout
                Spacing="15">


                <!-- HEADER -->

                <VerticalStackLayout
                    Spacing="4">


                    <Label
                        Text="ADD EXPENSE"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimary}" />


                    <Label
                        Text="Record a purchase and where it was paid."
                        FontSize="12"
                        TextColor="{DynamicResource TextSecondary}" />

                </VerticalStackLayout>



                <!-- NAME -->

                <VerticalStackLayout
                    Spacing="6">


                    <Label
                        Text="Expense Name"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Entry
                        x:Name="ExpenseNameEntry"
                        Placeholder="Chick-fil-A"
                        PlaceholderColor="{DynamicResource TextMuted}"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- AMOUNT -->

                <VerticalStackLayout
                    Spacing="6">


                    <Label
                        Text="Amount"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Entry
                        x:Name="ExpenseAmountEntry"
                        Placeholder="12.84"
                        PlaceholderColor="{DynamicResource TextMuted}"
                        Keyboard="Numeric"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- CATEGORY -->

                <VerticalStackLayout
                    Spacing="6">


                    <Label
                        Text="Category"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Picker
                        x:Name="ExpenseCategoryPicker"
                        Title="Choose a category"
                        TitleColor="{DynamicResource TextMuted}"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- PAID FROM -->

                <VerticalStackLayout
                    Spacing="6">


                    <Label
                        Text="Paid From"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Picker
                        x:Name="ExpensePaidFromPicker"
                        Title="Choose an account"
                        TitleColor="{DynamicResource TextMuted}"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- DATE -->

                <VerticalStackLayout
                    Spacing="6">


                    <Label
                        Text="Date"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <DatePicker
                        x:Name="ExpenseDatePicker"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- BUTTONS -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Margin="0,10,0,0">


                    <Button
                        Grid.Column="0"
                        Text="Cancel"
                        Clicked="CancelAddExpenseClicked"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}"
                        BorderColor="{DynamicResource BorderColor}"
                        BorderWidth="1"
                        CornerRadius="10" />


                    <Button
                        Grid.Column="1"
                        Text="Add Expense"
                        Clicked="AddExpenseClicked"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="10" />

                </Grid>

            </VerticalStackLayout>

        </Border>



        <!-- =====================================
             EDIT / DELETE EXPENSE MODAL
             ===================================== -->

        <Border
            x:Name="EditExpenseModal"
            ZIndex="30"
            IsVisible="False"
            BackgroundColor="{DynamicResource CardBackground}"
            Stroke="{DynamicResource BorderColor}"
            StrokeThickness="1"
            Padding="28"
            WidthRequest="460"
            HorizontalOptions="Center"
            VerticalOptions="Center">


            <Border.StrokeShape>

                <RoundRectangle
                    CornerRadius="18" />

            </Border.StrokeShape>


            <VerticalStackLayout
                Spacing="15">


                <!-- HEADER -->

                <VerticalStackLayout
                    Spacing="4">


                    <Label
                        Text="TRANSACTION DETAILS"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextPrimary}" />


                    <Label
                        Text="Update this transaction or remove it."
                        FontSize="12"
                        TextColor="{DynamicResource TextSecondary}" />

                </VerticalStackLayout>



                <!-- NAME -->

                <VerticalStackLayout
                    Spacing="6">


                    <Label
                        Text="Expense Name"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Entry
                        x:Name="EditExpenseNameEntry"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- AMOUNT -->

                <VerticalStackLayout
                    Spacing="6">


                    <Label
                        Text="Amount"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Entry
                        x:Name="EditExpenseAmountEntry"
                        Keyboard="Numeric"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- CATEGORY -->

                <VerticalStackLayout
                    Spacing="6">


                    <Label
                        Text="Category"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Picker
                        x:Name="EditExpenseCategoryPicker"
                        Title="Choose a category"
                        TitleColor="{DynamicResource TextMuted}"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- PAID FROM -->

                <VerticalStackLayout
                    Spacing="6">


                    <Label
                        Text="Paid From"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <Picker
                        x:Name="EditExpensePaidFromPicker"
                        Title="Choose an account"
                        TitleColor="{DynamicResource TextMuted}"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- DATE -->

                <VerticalStackLayout
                    Spacing="6">


                    <Label
                        Text="Date"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextSecondary}" />


                    <DatePicker
                        x:Name="EditExpenseDatePicker"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}" />

                </VerticalStackLayout>



                <!-- SAVE / CANCEL -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Margin="0,10,0,0">


                    <Button
                        Grid.Column="0"
                        Text="Cancel"
                        Clicked="CancelEditExpenseClicked"
                        BackgroundColor="{DynamicResource SurfaceBackground}"
                        TextColor="{DynamicResource TextPrimary}"
                        BorderColor="{DynamicResource BorderColor}"
                        BorderWidth="1"
                        CornerRadius="10" />


                    <Button
                        Grid.Column="1"
                        Text="Save Changes"
                        Clicked="SaveExpenseChangesClicked"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        TextColor="{DynamicResource TextOnPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="10" />

                </Grid>



                <!-- DELETE -->

                <Button
                    Text="Delete Transaction"
                    Clicked="DeleteExpenseClicked"
                    BackgroundColor="{DynamicResource DangerBackground}"
                    TextColor="{DynamicResource DangerColor}"
                    FontAttributes="Bold"
                    CornerRadius="10" />

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>