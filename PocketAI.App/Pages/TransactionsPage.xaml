<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PocketAI.App.Pages.TransactionsPage"
    BackgroundColor="#F5F7FA"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!-- ===================================== -->
        <!-- MAIN PAGE                             -->
        <!-- ===================================== -->

        <ScrollView>

            <VerticalStackLayout
                Padding="32"
                Spacing="24">

                <!-- HEADER -->

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="20">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="5">

                        <Label
                            Text="TRANSACTIONS"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="#111827" />

                        <Label
                            Text="Track and manage your spending."
                            FontSize="14"
                            TextColor="#6B7280" />

                    </VerticalStackLayout>


                    <Button
                        Grid.Column="1"
                        Text="+ Add Expense"
                        Clicked="ShowAddExpenseClicked"
                        BackgroundColor="#7C3AED"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Padding="18,12"
                        VerticalOptions="Start" />

                </Grid>


                <!-- THIS MONTH -->

                <Border
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="20"
                    WidthRequest="260"
                    HorizontalOptions="Start">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="THIS MONTH"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#6B7280" />

                        <Label
                            x:Name="ThisMonthTotalLabel"
                            Text="$0.00"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="#111827" />

                    </VerticalStackLayout>

                </Border>


                <!-- SEARCH + FILTERS -->

                <Grid
                    ColumnDefinitions="2*,*,*"
                    ColumnSpacing="12">

                    <SearchBar
                        x:Name="TransactionSearchBar"
                        Grid.Column="0"
                        Placeholder="Search transactions..."
                        TextChanged="TransactionSearchChanged"
                        BackgroundColor="White"
                        TextColor="#111827"
                        PlaceholderColor="#9CA3AF" />


                    <Picker
                        x:Name="CategoryPicker"
                        Grid.Column="1"
                        Title="All Categories"
                        SelectedIndexChanged="FilterChanged"
                        BackgroundColor="White"
                        TextColor="#111827" />


                    <Picker
                        x:Name="MonthPicker"
                        Grid.Column="2"
                        Title="Month"
                        SelectedIndexChanged="FilterChanged"
                        BackgroundColor="White"
                        TextColor="#111827" />

                </Grid>


                <!-- TRANSACTION TABLE -->

                <Border
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>


                    <VerticalStackLayout Spacing="0">

                        <!-- TABLE HEADER -->

                        <Grid
                            ColumnDefinitions="120,2*,1.5*,120"
                            Padding="18,14"
                            BackgroundColor="#F9FAFB">

                            <Label
                                Grid.Column="0"
                                Text="DATE"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#6B7280" />

                            <Label
                                Grid.Column="1"
                                Text="NAME"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#6B7280" />

                            <Label
                                Grid.Column="2"
                                Text="CATEGORY"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#6B7280" />

                            <Label
                                Grid.Column="3"
                                Text="AMOUNT"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#6B7280"
                                HorizontalTextAlignment="End" />

                        </Grid>


                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#E5E7EB" />


                        <!-- EMPTY MESSAGE -->

                        <Label
                            x:Name="NoTransactionsLabel"
                            Text="No transactions yet."
                            FontSize="14"
                            TextColor="#6B7280"
                            HorizontalOptions="Center"
                            Margin="0,30"
                            IsVisible="True" />


                        <!-- REAL TRANSACTIONS -->

                        <CollectionView
                            x:Name="TransactionsCollectionView"
                            SelectionMode="Single"
                            SelectionChanged="TransactionSelected">

                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <VerticalStackLayout Spacing="0">

                                        <Grid
                                            ColumnDefinitions="120,2*,1.5*,120"
                                            Padding="18,15">

                                            <Label
                                                Grid.Column="0"
                                                Text="{Binding DateText}"
                                                FontSize="14"
                                                TextColor="#374151"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Name}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="#111827"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding Category}"
                                                FontSize="14"
                                                TextColor="#6B7280"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Column="3"
                                                Text="{Binding AmountText}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                TextColor="#111827"
                                                HorizontalTextAlignment="End"
                                                VerticalOptions="Center" />


                                        </Grid>

                                        <BoxView
                                            HeightRequest="1"
                                            BackgroundColor="#F3F4F6" />

                                    </VerticalStackLayout>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>



        <!-- ===================================== -->
        <!-- DARK MODAL BACKGROUND                 -->
        <!-- ===================================== -->

        <BoxView
            x:Name="ModalBackground"
            ZIndex="10"
            BackgroundColor="#80000000"
            IsVisible="False">

            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="CancelAddExpenseClicked" />
            </BoxView.GestureRecognizers>

        </BoxView>



        <!-- ===================================== -->
        <!-- ADD EXPENSE MODAL                     -->
        <!-- ===================================== -->

        <Border
            x:Name="AddExpenseModal"
            ZIndex="20"
            IsVisible="False"
            BackgroundColor="White"
            Stroke="#E5E7EB"
            StrokeThickness="1"
            Padding="28"
            WidthRequest="440"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>


            <VerticalStackLayout Spacing="17">

                <Label
                    Text="ADD EXPENSE"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#111827" />


                <!-- NAME -->

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Expense Name"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#374151" />

                    <Entry
                        x:Name="ExpenseNameEntry"
                        Placeholder="Chick-fil-A"
                        BackgroundColor="#F9FAFB"
                        TextColor="#111827" />

                </VerticalStackLayout>


                <!-- AMOUNT -->

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Amount"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#374151" />

                    <Entry
                        x:Name="ExpenseAmountEntry"
                        Placeholder="12.84"
                        Keyboard="Numeric"
                        BackgroundColor="#F9FAFB"
                        TextColor="#111827" />

                </VerticalStackLayout>


                <!-- CATEGORY -->

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Category"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#374151" />

                    <Picker
                        x:Name="ExpenseCategoryPicker"
                        Title="Choose a category"
                        BackgroundColor="#F9FAFB"
                        TextColor="#111827" />

                </VerticalStackLayout>


                <!-- DATE -->

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Date"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#374151" />

                    <DatePicker
                        x:Name="ExpenseDatePicker"
                        BackgroundColor="#F9FAFB"
                        TextColor="#111827" />

                </VerticalStackLayout>


                <!-- BUTTONS -->

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Margin="0,10,0,0">

                    <Button
                        Grid.Column="0"
                        Text="Cancel"
                        Clicked="CancelAddExpenseClicked"
                        BackgroundColor="#E5E7EB"
                        TextColor="#374151"
                        CornerRadius="10" />

                    <Button
                        Grid.Column="1"
                        Text="Add Expense"
                        Clicked="AddExpenseClicked"
                        BackgroundColor="#7C3AED"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10" />

                <!-- ===================================== -->
                <!-- EDIT / DELETE EXPENSE MODAL           -->
                <!-- ===================================== -->

                <Border
                    x:Name="EditExpenseModal"
                    ZIndex="20"
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="28"
                    WidthRequest="440"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="17">

                        <Label
                            Text="TRANSACTION DETAILS"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#111827" />

                        <!-- NAME -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Expense Name"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#374151" />

                            <Entry
                                x:Name="EditExpenseNameEntry"
                                BackgroundColor="#F9FAFB"
                                TextColor="#111827" />
                        </VerticalStackLayout>

                        <!-- AMOUNT -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Amount"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#374151" />

                            <Entry
                                x:Name="EditExpenseAmountEntry"
                                Keyboard="Numeric"
                                BackgroundColor="#F9FAFB"
                                TextColor="#111827" />
                        </VerticalStackLayout>

                        <!-- CATEGORY -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Category"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#374151" />

                            <Picker
                                x:Name="EditExpenseCategoryPicker"
                                Title="Choose a category"
                                BackgroundColor="#F9FAFB"
                                TextColor="#111827" />
                        </VerticalStackLayout>

                        <!-- DATE -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Date"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#374151" />

                            <DatePicker
                                x:Name="EditExpenseDatePicker"
                                BackgroundColor="#F9FAFB"
                                TextColor="#111827" />
                        </VerticalStackLayout>

                        <!-- SAVE + CANCEL -->
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12"
                            Margin="0,10,0,0">

                            <Button
                                Grid.Column="0"
                                Text="Cancel"
                                Clicked="CancelEditExpenseClicked"
                                BackgroundColor="#E5E7EB"
                                TextColor="#374151"
                                CornerRadius="10" />

                            <Button
                                Grid.Column="1"
                                Text="Save Changes"
                                Clicked="SaveExpenseChangesClicked"
                                BackgroundColor="#7C3AED"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10" />

                        </Grid>

                        <!-- DELETE -->
                        <Button
                            Text="Delete Transaction"
                            Clicked="DeleteExpenseClicked"
                            BackgroundColor="#FEE2E2"
                            TextColor="#B91C1C"
                            FontAttributes="Bold"
                            CornerRadius="10" />

                    </VerticalStackLayout>

                </Border>

                </Grid>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>